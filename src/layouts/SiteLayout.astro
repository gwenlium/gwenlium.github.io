---
import analytics from '../content/analytics.json';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import BackgroundVfx from '../components/BackgroundVfx.astro';
import Player from '../components/Player.astro';
import Footer from '../components/Footer.astro';
import PixelTransition from '../components/PixelTransition.astro';
import Window from '../components/Window.astro';
import Typewriter from '../components/Typewriter.astro';
import SiteEditor from '../components/SiteEditor.astro';
import { site } from '../lib/settings';
import CustomWindows from '../components/CustomWindows.astro';
import { getWindowDefinition, type WindowPage } from '../lib/windows';
import '../styles/global.css';
import '../styles/window-layout.css';
import '../styles/page-themes.css';
import '../styles/controls.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  noindex?: boolean;
  /** The owner's writing page: no custom windows, and never indexed. */
  editor?: boolean;
  /** Colour theme when the address does not name a section (the draft preview). */
  theme?: string;
}

const { title, description = site.description, image, imageAlt, article = false, editor = false } = Astro.props;
const noindex = Astro.props.noindex || editor;
const pageTitle = title ? `${title} - ${site.name}` : site.name;
const siteUrl = Astro.site ?? new URL('https://gwenlium.dev');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = new URL(image || '/social-card.png?v=62a7927f5f70', siteUrl).href;
const socialImageAlt = imageAlt || (image ? site.name : `${site.name}'s desktop-style website with pixel lettering and an illustrated portrait.`);
const section = Astro.url.pathname.split('/').filter(Boolean)[0] || 'home';
const startWindow = getWindowDefinition('start-menu')!;
const preferencesWindow = getWindowDefinition('site-settings')!;
const playerWindow = getWindowDefinition('music-player')!;
const pageTheme = Astro.props.theme ?? (editor ? 'devlog' : ['home', 'devlog', 'life', 'gallery', 'music', 'about', 'subscribe'].includes(section) ? section : 'not-found');
const windowPage: WindowPage = article ? 'post' : pageTheme as WindowPage;
---

<!doctype html>
<html lang="en" data-page-theme={pageTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let saved = {};
        try {
          const value = JSON.parse(localStorage.getItem('gwenlium:preferences') || '{}');
          if (value && typeof value === 'object') saved = value;
        } catch {}
        if (saved.background === 'rain' || saved.background === 'checker') {
          saved.background = saved.background === 'checker' ? 'hills' : 'weave';
          try { localStorage.setItem('gwenlium:preferences', JSON.stringify(saved)); } catch {}
        }
        try {
          const previous = localStorage.getItem('gwenlium:background:last-auto');
          if (previous === 'rain' || previous === 'checker') {
            localStorage.setItem('gwenlium:background:last-auto', previous === 'checker' ? 'hills' : 'weave');
          }
        } catch {}
        const theme = ['light', 'dark', 'system'].includes(saved.theme) ? saved.theme : 'system';
        const motion = ['full', 'reduced', 'system'].includes(saved.motion) ? saved.motion : 'system';
        const reading = saved.reading === 'readable' ? 'readable' : 'pixel';
        const root = document.documentElement;
        root.dataset.dialogue = saved.dialogue === 'on' ? 'on' : 'off';
        const backgrounds = { auto: true, dots: true, polygons: true, circuits: true, hills: true, wave: true, stars: true, weave: true, off: true };
        const background = typeof saved.background === 'string' && Object.hasOwn(backgrounds, saved.background) ? saved.background : 'auto';
        if (!root.dataset.backgroundAuto) {
          const presets = ['dots', 'polygons', 'circuits', 'hills', 'wave', 'stars', 'weave'];
          let previous = -1;
          try { previous = presets.indexOf(localStorage.getItem('gwenlium:background:last-auto')); } catch {}
          const choice = previous < 0 ? Math.floor(Math.random() * presets.length) : (previous + 1 + Math.floor(Math.random() * (presets.length - 1))) % presets.length;
          root.dataset.backgroundAuto = presets[choice];
          if (background === 'auto') {
            try { localStorage.setItem('gwenlium:background:last-auto', root.dataset.backgroundAuto); } catch {}
          }
        }
        root.dataset.background = background;
        root.dataset.backgroundActive = background === 'auto' ? root.dataset.backgroundAuto : background;
        root.dataset.themePreference = theme;
        root.dataset.motionPreference = motion;
        root.dataset.theme = theme === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme;
        root.dataset.motion = motion === 'system' ? (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full') : motion;
        root.dataset.reading = reading;
        root.style.colorScheme = root.dataset.theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="follow.it-verification-code" content="D7cXwVHWmkDT9zzhMcBl" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Journal`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {!image && <>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script>
      // Handle same-page mobile view history before Astro can replace the page.
      import '../scripts/mobile-windows';
    </script>
    <ClientRouter />
    {import.meta.env.PROD && !editor && Astro.url.hostname === siteUrl.hostname && /^[a-f0-9]{32}$/i.test(analytics.cloudflareBeaconToken) && <script is:inline data-beacon={JSON.stringify({ token: analytics.cloudflareBeaconToken })}>
      (() => {
        // A browser that holds the owner's editor sign-in (ownerHintKey in src/lib/editor-config.ts) runs no outside scripts.
        try { if (localStorage.getItem('gwenlium:owner') === '1') return; } catch {}
        if (window.gwenliumBeacon) return;
        window.gwenliumBeacon = true;
        const beacon = document.createElement('script');
        beacon.defer = true;
        beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        beacon.dataset.cfBeacon = document.currentScript.dataset.beacon;
        document.head.append(beacon);
      })();
    </script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div transition:persist="site-background"><BackgroundVfx /></div>
    <div class="site-shell application-shell">
      <header class="site-header">
        <a class="site-brand" href="/" aria-label={`${site.name}, home`} transition:persist="site-brand">
          <span class="brand-icon"><img class="brand-avatar" src="/avatar.webp" alt="" width="43" height="43" /></span>
          <span data-site-edit-file="src/content/site.json" data-site-edit-field="/name" data-site-edit-format="text" data-site-edit-label="Site name"><Typewriter text={site.name} caretClass="brand-caret" /></span>
        </a>
        {site.status && <span class="site-status"><i aria-hidden="true"></i><span data-site-edit-file="src/content/site.json" data-site-edit-field="/status" data-site-edit-format="text" data-site-edit-label="Site status">{site.status}</span></span>}
      </header>

      <div id="page-scroll" tabindex="0" role="region" aria-label="Page content" transition:name="page-content" transition:animate="none">
        <main id="main-content" class="page-content" tabindex="-1">
          <slot />
          {!editor && <CustomWindows page={windowPage} />}
        </main>
      </div>

      <div class="player-region"><Player /></div>
      <Footer />
      <div class="taskbar" role="toolbar" aria-label="Desktop controls">
        <button type="button" class="button-secondary" data-mobile-back aria-label="Back to previous view" disabled><span aria-hidden="true">←</span>Back</button>
        <button type="button" class="button-secondary start-trigger" data-open-start aria-controls="start-menu" aria-haspopup="dialog" aria-expanded="false">
          <img src="/avatar.webp" alt="" width="22" height="22" /><span class="desktop-label">{startWindow.title}</span><span class="mobile-label">Menu</span>
        </button>
        <button type="button" class="button-secondary taskbar-control" data-open-settings aria-controls="site-settings" aria-expanded={!preferencesWindow.initiallyClosed} aria-label={preferencesWindow.title}>
          <Icon name="settings" size={17} /><span>{preferencesWindow.title}</span>
        </button>
        <button type="button" class="button-secondary taskbar-control" data-open-player aria-controls="music-player" aria-expanded={!playerWindow.initiallyClosed} aria-label={`${playerWindow.title} player`}>
          <Icon name="music" size={17} /><span class="desktop-label">{playerWindow.title}</span><span class="mobile-label">Music</span>
        </button>
        <button type="button" class="button-secondary taskbar-control owner-taskbar" data-owner-menu data-owner-editor aria-haspopup="menu" hidden><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 20 4-1 11-11-3-3L5 16l-1 4ZM14 7l3 3" /></svg><span>Edit</span></button>
        <button type="button" class="button owner-taskbar owner-taskbar--publish" data-owner-publish hidden>Publish</button>
        <div class="taskbar-windows" data-taskbar-windows role="group" aria-label="Open windows"></div>
        <button type="button" class="button-secondary taskbar-control" data-auto-arrange-windows aria-label="Auto arrange windows" title="Restore the responsive default layout of open windows">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" /></svg><span>Auto arrange</span>
        </button>
        <button type="button" class="button-secondary taskbar-control taskbar-restore" data-restore-windows aria-label="Restore windows">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 8V3h13v13h-5M3 8h13v13H3ZM3 12h13" /></svg><span>Restore windows</span>
        </button>
      </div>
    </div>

    <PixelTransition />
    <Window windowId="site-settings" class="settings-window">
      <div class="settings-content">
        <header class="settings-intro"><span class="eyebrow">Make yourself at home</span><h2>Your space, your pace.</h2><p>Changes apply immediately across the site.</p></header>
        <section class="settings-section" aria-labelledby="settings-reading-title">
          <h3 id="settings-reading-title"><Icon name="book" size={18} />Reading</h3>
          <label class="preference-switch" for="dialogue-preference">
            <span><strong>Dialogue mode</strong><small>Read one passage at a time in posts, About and other text windows.</small></span>
            <input id="dialogue-preference" type="checkbox" role="switch" data-preference="dialogue" aria-describedby="dialogue-preference-help" />
            <span class="preference-switch__track" aria-hidden="true"></span>
          </label>
          <p class="settings-help" id="dialogue-preference-help">On for every page. You can still choose “Read all” for an individual entry.</p>
        <fieldset class="preference-group">
          <legend>Reading font</legend>
          <div class="preference-options preference-options--font">
            <label class="font-option-readable"><input type="radio" name="reading" value="readable" data-preference="reading" />Readable</label>
            <label><input type="radio" name="reading" value="pixel" data-preference="reading" checked />Pixel</label>
          </div>
          <p>Changes the font used for posts and longer text.</p>
        </fieldset>
        </section>
        <section class="settings-section" aria-labelledby="settings-appearance-title">
          <h3 id="settings-appearance-title"><Icon name="sun" size={18} />Appearance</h3>
        <fieldset class="preference-group">
          <legend>Theme</legend>
          <div class="preference-options">
            <label><input type="radio" name="theme" value="light" data-preference="theme" /><Icon name="sun" size={17} />Light</label>
            <label><input type="radio" name="theme" value="dark" data-preference="theme" /><Icon name="moon" size={17} />Dark</label>
            <label><input type="radio" name="theme" value="system" data-preference="theme" checked />System</label>
          </div>
        </fieldset>
          <details class="settings-background"><summary>Desktop background <span>Choose a pattern</span></summary>
        <fieldset class="preference-group" aria-describedby="background-preference-help">
          <legend>Background</legend>
          <div class="preference-options">
            <label><input type="radio" name="background" value="auto" data-preference="background" checked />Auto</label>
            <label><input type="radio" name="background" value="dots" data-preference="background" />Dots</label>
            <label><input type="radio" name="background" value="polygons" data-preference="background" />Polygons</label>
            <label><input type="radio" name="background" value="circuits" data-preference="background" />Circuits</label>
            <label><input type="radio" name="background" value="hills" data-preference="background" />Pixel hills</label>
            <label><input type="radio" name="background" value="wave" data-preference="background" />Wave mesh</label>
            <label><input type="radio" name="background" value="stars" data-preference="background" />Pixel stars</label>
            <label><input type="radio" name="background" value="weave" data-preference="background" />Desktop weave</label>
            <label><input type="radio" name="background" value="off" data-preference="background" />Off</label>
          </div>
          <p id="background-preference-help">Auto changes the wallpaper on each new visit. Pixel hills follows your scrolling; Desktop weave is stationary. Reduced motion keeps every wallpaper still.</p>
        </fieldset>
          </details>
        </section>
        <section class="settings-section" aria-labelledby="settings-motion-title">
          <h3 id="settings-motion-title"><Icon name="play" size={18} />Motion</h3>
        <fieldset class="preference-group">
          <legend>Motion</legend>
          <div class="preference-options">
            <label><input type="radio" name="motion" value="full" data-preference="motion" />Full</label>
            <label><input type="radio" name="motion" value="reduced" data-preference="motion" />Reduced</label>
            <label><input type="radio" name="motion" value="system" data-preference="motion" checked />System</label>
          </div>
          <p>System follows your device’s accessibility preference. Reduced motion skips text typing.</p>
        </fieldset>
        </section>
        <div class="settings-bottom">
          <p data-preferences-status role="status" aria-live="polite">Saved on this device.</p>
          <button type="button" class="button" data-close-settings>Done<Icon name="arrow" size={16} /></button>
        </div>
      </div>
    </Window>
    <SiteEditor />
    <script>
      import '../scripts/preferences';
      import '../scripts/shell';
      import '../scripts/media';
      import '../scripts/controls';
    </script>
  </body>
</html>
