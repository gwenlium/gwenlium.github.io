---
import TopicFilter from '../components/TopicFilter.astro';
import { topicOptions } from '../lib/topics.mjs';
import { pages } from '../lib/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { gallery } from '../lib/settings';
const images = gallery.filter((item) => item.type === 'image').length;
const videos = gallery.filter((item) => item.type === 'video').length;
---

<SiteLayout title={pages.gallery.title}>
  <header class="page-heading">
    <span class="eyebrow">{pages.gallery.eyebrow}</span>
    <h1>{pages.gallery.title}</h1>
    {pages.gallery.intro && <p class="page-intro">{pages.gallery.intro}</p>}
  </header>
  <Window windowId="gallery-content">
  {gallery.length ? (
    <section data-gallery data-topic-catalogue="gallery" aria-label="Gallery">
      <div class="gallery-toolbar">
        <div class="gallery-filters" role="group" aria-label="Filter gallery">
          <button type="button" class="button-secondary" data-gallery-filter="all" aria-pressed="true">All <span>{gallery.length}</span></button>
          <button type="button" class="button-secondary" data-gallery-filter="image" aria-pressed="false">Images <span>{images}</span></button>
          <button type="button" class="button-secondary" data-gallery-filter="video" aria-pressed="false">Video <span>{videos}</span></button>
        </div>

      </div>
      <TopicFilter topics={topicOptions(gallery)} id="gallery-topic" search />
      <div class="gallery-grid">
        {gallery.map((item) => (
          <article class="gallery-item" data-gallery-type={item.type} data-item-topics={JSON.stringify(item.topics)} id={`work-${item.id}`}>
            <div class="gallery-item-heading"><span aria-hidden="true"><Icon name={item.type === 'video' ? 'play' : 'image'} size={13} /></span><h2>{item.title}</h2></div>
            <div class="gallery-item-body">
              <Media src={item.src} alt={item.alt} caption={item.caption} type={item.type} poster={item.poster} sizes="(max-width: 640px) calc(100vw - 3rem), (max-width: 1100px) 40vw, 30vw" />
              {item.topics.length > 0 && <div class="topic-tags">{item.topics.map(topic => <button type="button" class="tag" data-topic-pick={topic}>{topic}</button>)}</div>}
            </div>
          </article>
        ))}
      </div>
    </section>
  ) : (
      <div class="empty-state">
        <Icon name="image" size={36} />
        <h2>No work published yet</h2>
      </div>
  )}
  </Window>
</SiteLayout>

<style>
  .topic-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .75rem; }
  .topic-tags button { min-height: 44px; cursor: pointer; }
  .gallery-toolbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-bottom: clamp(.75rem, 3cqi, 1.2rem); margin-bottom: clamp(1rem, 4cqi, 1.7rem); border-bottom: 1px solid var(--line); }
  .gallery-filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .gallery-filters button { font: inherit; font-size: .7rem; cursor: pointer; }
  .gallery-filters button[aria-pressed='true'] { background: var(--ink); color: var(--surface); }
  .gallery-filters span { font-size: .6rem; opacity: .75; }
  .gallery-toolbar p { font-size: .65rem; color: var(--muted); margin: 0; }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 265px), 1fr)); gap: clamp(.75rem, 3cqi, 1.5rem); align-items: start; }
  .gallery-item { min-width: 0; border: 1px solid var(--line); border-top-color: var(--surface-raised); border-left-color: var(--surface-raised); background: var(--surface); box-shadow: var(--shadow); }
  .gallery-item[hidden] { display: none; }
  .gallery-item-heading { display: flex; align-items: center; gap: .55rem; padding: .55rem .7rem; background: var(--sage); border-bottom: 1px solid var(--line); }
  .gallery-item:nth-child(3n + 2) .gallery-item-heading { background: var(--pink); }
  .gallery-item:nth-child(3n) .gallery-item-heading { background: var(--lavender); }
  .gallery-item h2 { margin: 0; font-size: clamp(.7rem, .6rem + .3cqi, .8rem); font-weight: 400; overflow-wrap: anywhere; }
  .gallery-item-body { padding: clamp(.4rem, 2cqi, .65rem); }
  .gallery-item :global(img) { max-height: 470px; object-fit: contain; }
  .empty-state :global(svg) { margin-inline: auto; }
</style>
