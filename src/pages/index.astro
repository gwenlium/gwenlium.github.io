---
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PostCard from '../components/PostCard.astro';
import { site, gallery, tracks } from '../lib/settings';
import { getPosts, postUrl, formatDate } from '../lib/content';

const posts = await getPosts();
const featuredPost = posts.find((post) => post.data.permalink === site.featuredPost)
  ?? posts.find((post) => post.data.featured)
  ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
const galleryPreview = gallery.filter((item) => item.src).slice(0, 3);
const musicPreview = tracks.filter((track) => track.src).slice(0, 3);
const game = site.game;
const gameVideo = /\.(mp4|webm|ogv)(?:[?#].*)?$/i.test(game.trailerUrl) ? game.trailerUrl : '';
const hasGame = Boolean(game.title || game.description || game.cover || game.trailerUrl || game.status || game.links.length);
---

<SiteLayout>
  <div class="home-page">
    <Window title={`${site.name} / home`} class="home-hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <span class="hero-location"><span aria-hidden="true"></span>Home</span>
          <h1>{site.name}<span aria-hidden="true">_</span></h1>
          {site.intro && <p class="hero-intro">{site.intro}</p>}
          <div class="hero-actions">
            <a class="button" href="/devlog/">Open devlog<Icon name="arrow" size={16} /></a>
            <a class="button-secondary" href="/about/">About<Icon name="user" size={15} /></a>
          </div>
        </div>
      </div>
      <div class="hero-statusbar"><span><img src="/avatar.webp" alt="" width="16" height="16" />gwenlium.dev</span><span aria-hidden="true">◆ &nbsp; ◇ &nbsp; ◇</span></div>
    </Window>

    {hasGame && (
      <Window title="Featured game" class="featured-game">
        <div class:list={['game-preview', { 'game-preview--with-media': game.cover || gameVideo }]}>
          {(game.cover || gameVideo) && (
            <div class="game-preview__media">
              {game.cover
                ? <Media src={game.cover} alt={game.coverAlt} eager />
                : <Media src={gameVideo} type="video" alt={game.coverAlt} />}
            </div>
          )}
          <div class="game-preview__copy">
            <p class="eyebrow"><Icon name="game" size={15} />Game</p>
            <h2>{game.title || 'Game'}</h2>
            {game.status && <p class="game-status"><span aria-hidden="true"></span>{game.status}</p>}
            {game.description && <p class="game-description">{game.description}</p>}
            <div class="game-actions">
              <a class="button" href="/game/">View game<Icon name="arrow" size={16} /></a>
              {game.trailerUrl && <a class="game-trailer" href={game.trailerUrl}><Icon name="play" size={14} />Watch trailer</a>}
            </div>
          </div>
        </div>
      </Window>
    )}

    <div class="home-columns">
      <Window title={featuredPost && (site.featuredPost === featuredPost.data.permalink || featuredPost.data.featured) ? 'Featured devlog' : 'Latest devlog'} class="home-devlog">
        {featuredPost ? (
          <>
            <PostCard post={featuredPost} />
            {recentPosts.length > 0 && (
              <div class="recent-posts">
                <h2 class="eyebrow">Recent entries</h2>
                <ul>
                  {recentPosts.map((post) => (
                    <li><a href={postUrl(post)}><span>{post.data.title}</span><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time><Icon name="arrow" size={14} /></a></li>
                  ))}
                </ul>
              </div>
            )}
            <a class="all-posts" href="/devlog/">All devlog entries<Icon name="arrow" size={14} /></a>
          </>
        ) : (
          <div class="devlog-empty">
            <span class="empty-book"><Icon name="book" size={30} /></span>
            <div><h2>Devlog</h2><p>No published posts yet.</p><a href="/devlog/">Open the devlog<Icon name="arrow" size={14} /></a></div>
          </div>
        )}
      </Window>

      <div class="home-side">
        <Window title="Follow along" tone="lavender" class="follow-window">
          <div class="follow-heading"><span><Icon name="rss" size={23} /></span><h2>Devlog<br />updates</h2></div>
          <p class="follow-description">Read published posts in your feed reader.</p>
          <a class="button-secondary feed-button" href="/rss.xml"><Icon name="rss" size={16} />RSS feed<Icon name="arrow" size={14} /></a>
          <a class="subscribe-link" href="/subscribe/"><Icon name="mail" size={15} />{site.newsletterUrl ? 'Email updates' : 'Subscription options'}<Icon name="chevron" size={13} /></a>
        </Window>
        <a class="github-link" href={site.githubUrl}><span>GitHub</span><span>gwenlium<Icon name="external" size={13} /></span></a>
      </div>
    </div>

    {galleryPreview.length > 0 && (
      <Window title="Gallery" tone="pink" class="home-gallery">
        <div class="section-heading"><h2><Icon name="image" size={20} />Gallery</h2><a href="/gallery/">View gallery<Icon name="arrow" size={15} /></a></div>
        <div class="gallery-preview">
          {galleryPreview.map((item) => (
            <div class="gallery-preview__item">
              <Media src={item.src} type={item.type} alt={item.alt} poster={item.poster} />
              {item.title && <h3>{item.title}</h3>}
            </div>
          ))}
        </div>
      </Window>
    )}

    {musicPreview.length > 0 && (
      <Window title="Music" tone="lavender" class="home-music">
        <div class="section-heading"><h2><Icon name="music" size={20} />Music</h2><a href="/music/">All tracks<Icon name="arrow" size={15} /></a></div>
        <ul class="music-preview">
          {musicPreview.map((track, index) => (
            <li>
              <button type="button" data-play-track={track.id} aria-label={`Play ${track.title}`}>
                <span class="track-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="track-cover">{track.cover ? <img src={track.cover} alt={track.coverAlt} width="40" height="40" loading="lazy" decoding="async" /> : <Icon name="music" size={19} />}</span>
                <span class="track-title">{track.title}</span>
                <span class="track-play"><Icon name="play" size={15} /><span>Play</span></span>
              </button>
            </li>
          ))}
        </ul>
      </Window>
    )}
  </div>
</SiteLayout>

<style>
  .home-page { display: grid; gap: 1.55rem; }
  :global(.home-hero > .window-body) { padding: 0; }
  .hero-inner { position: relative; isolation: isolate; min-height: 395px; overflow: hidden; }
  .hero-copy { position: relative; max-width: 75%; padding: clamp(2rem, 4.5vw, 4.25rem) clamp(1.5rem, 3.8vw, 3.5rem) 4rem; }
  .hero-location { display: inline-flex; align-items: center; gap: .6rem; padding: .3rem .55rem; margin-bottom: 1.65rem; border: 1px solid color-mix(in srgb, var(--line) 55%, transparent); background: color-mix(in srgb, var(--surface-raised) 58%, transparent); font-size: 9px; line-height: 1.5; text-transform: uppercase; letter-spacing: .14em; }
  .hero-location > span { display: block; width: 5px; height: 5px; background: var(--accent-ink); }
  h1 { margin: 0 0 1.4rem; font-size: clamp(2.7rem, 6.8vw, 5.35rem); line-height: 1.1; letter-spacing: -.065em; text-shadow: 2px 3px 0 color-mix(in srgb, var(--surface) 70%, transparent); }
  h1 > span { color: var(--line); }
  .hero-intro { max-width: 43ch; margin-bottom: 1.7rem; font-family: var(--font-reading); font-size: 1rem; line-height: 1.75; white-space: pre-line; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
  .hero-actions .button-secondary { background: color-mix(in srgb, var(--surface-raised) 86%, transparent); }
  .hero-statusbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 26px; padding: .3rem .7rem; border-top: 1px solid var(--line); box-shadow: inset 0 1px var(--bevel-light); color: var(--muted); font-size: 9px; }
  .hero-statusbar > span:first-child { display: inline-flex; align-items: center; gap: .45rem; }
  .hero-statusbar > span:last-child { letter-spacing: .13em; }
  .game-preview { display: grid; gap: 1.75rem; }
  .game-preview--with-media { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
  .game-preview__media { min-width: 0; }
  .game-preview__media :global(figure) { margin: 0; }
  .game-preview__media :global(img), .game-preview__media :global(video) { width: 100%; max-height: 340px; object-fit: contain; }
  .game-preview h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin-bottom: .75rem; }
  .game-status { display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); font-size: 10px; margin-bottom: 1rem; }
  .game-status > span { width: 5px; height: 5px; background: var(--accent-ink); }
  .game-description { font-family: var(--font-reading); font-size: .95rem; line-height: 1.75; white-space: pre-line; }
  .game-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.25rem; }
  .game-trailer { display: inline-flex; align-items: center; gap: .45rem; font-size: 10px; }
  .home-columns { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(240px, 1fr); gap: 1.55rem; align-items: start; }
  .home-side { display: grid; gap: .65rem; min-width: 0; }
  .devlog-empty { display: flex; align-items: center; gap: 1.4rem; min-height: 174px; padding: .75rem; }
  .empty-book { display: grid; place-items: center; flex-shrink: 0; width: 64px; height: 70px; border: 1px solid var(--line); background: repeating-linear-gradient(0deg, transparent, transparent 11px, color-mix(in srgb, var(--line) 11%, transparent) 11px, color-mix(in srgb, var(--line) 11%, transparent) 12px), var(--surface-raised); box-shadow: 3px 3px 0 var(--sage); color: var(--muted); }
  .devlog-empty h2 { font-size: 1.2rem; margin: 0 0 .6rem; }
  .devlog-empty p { font-family: var(--font-reading); font-size: .9rem; color: var(--muted); margin: 0 0 .85rem; }
  .devlog-empty a { display: inline-flex; align-items: center; gap: .6rem; font-size: 10px; }
  .recent-posts { border-top: 1px solid var(--line); margin-top: 1.4rem; padding-top: 1.25rem; }
  .recent-posts > h2 { margin: 0 0 .5rem; }
  .recent-posts ul { list-style: none; padding: 0; margin: 0; }
  .recent-posts li + li { border-top: 1px solid color-mix(in srgb, var(--line) 25%, transparent); }
  .recent-posts li a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .35rem .9rem; padding: .8rem 0; text-decoration: none; font-size: 11px; }
  .recent-posts li a:hover > span { text-decoration: underline; }
  .recent-posts time { grid-row: 2; color: var(--muted); font-size: 9px; }
  .recent-posts li svg { grid-row: 1 / 3; grid-column: 2; }
  .all-posts { display: inline-flex; align-items: center; gap: .7rem; font-size: 10px; margin-top: 1.3rem; }
  .follow-heading { display: flex; align-items: center; gap: .9rem; margin-bottom: .95rem; }
  .follow-heading > span { display: grid; place-items: center; width: 43px; height: 43px; flex-shrink: 0; border: 1px solid var(--line); background: var(--lavender); box-shadow: inset 1px 1px var(--bevel-light), 2px 2px 0 color-mix(in srgb, var(--line) 20%, transparent); }
  .follow-heading h2 { margin: 0; font-size: 1rem; line-height: 1.5; }
  .follow-description { color: var(--muted); font-family: var(--font-reading); font-size: .85rem; line-height: 1.65; margin: 0 0 1rem; }
  .feed-button { width: 100%; justify-content: flex-start; }
  .feed-button > :last-child { margin-left: auto; }
  .subscribe-link { display: flex; align-items: center; gap: .55rem; font-size: 10px; margin-top: .8rem; padding: .35rem .1rem; text-decoration: none; }
  .subscribe-link:hover { text-decoration: underline; }
  .subscribe-link > :last-child { margin-left: auto; }
  .github-link { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .5rem .25rem; color: var(--muted); font-size: 10px; text-decoration: none; }
  .github-link > span:last-child { display: inline-flex; align-items: center; gap: .5rem; }
  .github-link:hover > span:first-child { text-decoration: underline; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; }
  .section-heading h2 { display: flex; align-items: center; gap: .65rem; font-size: 1.25rem; margin: 0; }
  .section-heading a { display: inline-flex; align-items: center; gap: .6rem; font-size: 10px; }
  .gallery-preview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .gallery-preview__item { min-width: 0; }
  .gallery-preview__item :global(figure) { margin: 0; }
  .gallery-preview__item :global(img), .gallery-preview__item :global(video) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gallery-preview__item h3 { margin: .65rem 0 0; font-size: 11px; line-height: 1.55; }
  .music-preview { list-style: none; padding: 0; margin: 0; }
  .music-preview li + li { border-top: 1px solid color-mix(in srgb, var(--line) 35%, transparent); }
  .music-preview button { display: flex; align-items: center; gap: .9rem; width: 100%; min-width: 0; padding: .65rem .4rem; border: 0; background: transparent; text-align: left; }
  .music-preview button:hover { background: color-mix(in srgb, var(--lavender) 25%, transparent); }
  .track-number { color: var(--muted); font-size: 10px; }
  .track-cover { display: grid; place-items: center; flex-shrink: 0; width: 40px; height: 40px; background: var(--lavender); border: 1px solid var(--line); }
  .track-cover img { width: 100%; height: 100%; object-fit: cover; }
  .track-title { font-size: 12px; min-width: 0; }
  .track-play { display: inline-flex; align-items: center; gap: .5rem; margin-left: auto; padding-left: .5rem; font-size: 10px; }

  @media (min-width: 1400px) {
    .hero-inner { min-height: 430px; }
    .hero-copy { padding-top: 4.8rem; }
  }
  @media (max-width: 1150px) {
    .home-columns { grid-template-columns: minmax(0, 1.4fr) minmax(220px, 1fr); gap: 1.1rem; }
    .hero-copy { max-width: 90%; }
    .hero-inner { min-height: 370px; }
    .devlog-empty { gap: 1rem; padding: .5rem 0; }
    .empty-book { width: 48px; height: 56px; }
  }
  @media (max-width: 950px) {
    .home-columns { grid-template-columns: minmax(0, 1fr); }
    .home-side { grid-template-columns: minmax(0, 1fr); }
    .hero-copy { max-width: 100%; }
    .game-preview--with-media { grid-template-columns: minmax(0, 1fr); gap: 1.3rem; }
    .gallery-preview { gap: .75rem; }
    .devlog-empty { min-height: 140px; padding: .5rem; }
  }
  @media (max-width: 760px) {
    .home-page { gap: 1.15rem; }
    .home-columns { grid-template-columns: minmax(0, 1.5fr) minmax(215px, 1fr); }
    .hero-inner { min-height: 365px; }
    .hero-copy { max-width: 85%; padding: 2.3rem 1.75rem 3rem; }
    h1 { font-size: clamp(2.8rem, 8.5vw, 4.5rem); }
  }
  @media (max-width: 620px) {
    .home-columns { grid-template-columns: minmax(0, 1fr); }
    .hero-inner { min-height: 400px; }
    .hero-copy { max-width: 100%; padding: 1.9rem 1.35rem 3rem; }
    .hero-location { margin-bottom: 1.1rem; }
    h1 { margin-bottom: 1.25rem; font-size: clamp(2.65rem, 10vw, 4rem); }
    .hero-intro { font-size: .95rem; }
    .gallery-preview { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; }
    .gallery-preview__item :global(img), .gallery-preview__item :global(video) { max-height: 340px; object-fit: contain; }
    .track-play > span { display: none; }
    .music-preview button { gap: .6rem; }
  }
</style>
