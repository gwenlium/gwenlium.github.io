---
import DialogueReader from '../components/DialogueReader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PostCard from '../components/PostCard.astro';
import { site, gallery, tracks } from '../lib/settings';
import { getPosts, postUrl, postSourceFile, formatDate } from '../lib/content';
import { getWindowDefinition, hasWindowOverride } from '../lib/windows';

const posts = await getPosts();
const homeIntro = site.intro || site.description;
const featuredPost = posts.find((post) => post.data.permalink === site.featuredPost)
  ?? posts.find((post) => post.data.featured)
  ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
const galleryPreview = gallery.filter((item) => item.src).slice(0, 3);
const musicPreview = tracks.filter((track) => track.src).slice(0, 3);
const game = site.game;
const hasGame = Boolean(game.title || game.description || game.cover || game.trailerUrl || game.status || game.links.length);
---

<SiteLayout>
  <div class="home-page">
    <div class="home-primary">
    <div class="home-slot home-slot--intro">
    <Window windowId="home-intro" class="home-hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <span class="hero-location"><span aria-hidden="true"></span>Home</span>
          <h1><span data-site-edit-file="src/content/site.json" data-site-edit-field="/name" data-site-edit-format="text" data-site-edit-label="Site name">{site.name}</span><span class="text-caret" aria-hidden="true">|</span></h1>
          {homeIntro && <DialogueReader id="home-reading"><div data-dialogue-blocks data-site-edit-file="src/content/site.json" data-site-edit-field={site.intro ? '/intro' : '/description'} data-site-edit-format="text" data-site-edit-label="Home introduction">{homeIntro.split(/\n\s*\n/).map(paragraph => <p class="hero-intro">{paragraph}</p>)}</div></DialogueReader>}
        </div>
      </div>
      <div class="hero-statusbar"><span><img src="/avatar.webp" alt="" width="16" height="16" />gwenlium.dev</span><span aria-hidden="true">◆ &nbsp; ◇ &nbsp; ◇</span></div>
    </Window>
    </div>

    {(hasGame || hasWindowOverride('home-game') || getWindowDefinition('home-game')?.enabled === false) && (
      <div class="home-slot home-slot--game">
      <Window windowId="home-game" class="featured-game">
        <div class="game-preview">
          <div class="game-preview__copy">
            <p class="eyebrow"><Icon name="game" size={15} />Game development</p>
            <h2 data-site-edit-file={game.title ? 'src/content/site.json' : undefined} data-site-edit-field={game.title ? '/game/title' : undefined} data-site-edit-format={game.title ? 'text' : undefined} data-site-edit-label={game.title ? 'Game title' : undefined}>{game.title || 'Game'}</h2>
            {game.status && <p class="game-status"><span aria-hidden="true"></span><span data-site-edit-file="src/content/site.json" data-site-edit-field="/game/status" data-site-edit-format="text" data-site-edit-label="Game status">{game.status}</span></p>}
            {game.description && <p class="game-description" data-site-edit-file="src/content/site.json" data-site-edit-field="/game/description" data-site-edit-format="text" data-site-edit-label="Game description">{game.description}</p>}
            <div class="game-actions">
              <a href="/devlog/">Devlog <Icon name="arrow" size={14} /></a>
              {game.trailerUrl && <a class="game-trailer" href={game.trailerUrl}><Icon name="play" size={14} />Watch trailer</a>}
            </div>
          </div>
        </div>
      </Window>
      </div>
    )}
    </div>
    <div class="home-secondary">

    <div class="home-slot home-slot--journal">
      <Window windowId="home-devlog" class="home-devlog">
        {featuredPost ? (
          <>
            <PostCard post={featuredPost} compact />
            {recentPosts.length > 0 && (
              <div class="recent-posts">
                <h2 class="eyebrow">Recent entries</h2>
                <ul>
                  {recentPosts.map((post) => (
                    <li><a href={postUrl(post)}><span data-site-edit-file={postSourceFile(post)} data-site-edit-field="/title" data-site-edit-format="text" data-site-edit-label="Post title">{post.data.title}</span><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time><Icon name="arrow" size={14} /></a></li>
                  ))}
                </ul>
              </div>
            )}
          </>
        ) : (
          <div class="devlog-empty">
            <span class="empty-book"><Icon name="book" size={30} /></span>
            <div><h2>Journal</h2><p>No published posts yet.</p></div>
          </div>
        )}
      </Window>

    </div>

    {(galleryPreview.length > 0 || hasWindowOverride('home-gallery') || getWindowDefinition('home-gallery')?.enabled === false) && (
      <div class="home-slot home-slot--gallery">
      <Window windowId="home-gallery" class="home-gallery">
        <div class="section-heading"><h2><Icon name="image" size={20} />Gallery</h2><a href="/gallery/">Browse gallery <Icon name="arrow" size={14} /></a></div>
        <div class="gallery-preview">
          {galleryPreview.map((item) => (
            <div class="gallery-preview__item">
              {item.title && <h3><a href={`/gallery/#work-${item.id}`} data-site-edit-file="src/content/gallery.json" data-site-edit-field={`/items/@${item.id.replaceAll('~', '~0').replaceAll('/', '~1')}/title`} data-site-edit-format="text" data-site-edit-label="Gallery title">{item.title}</a></h3>}
              <Media src={item.src} type={item.type} alt={item.alt} caption={item.caption} poster={item.poster} sizes="(min-width: 1000px) 480px, (max-width: 640px) 90vw, 600px" editFile="src/content/gallery.json" editField={`/items/@${item.id.replaceAll('~', '~0').replaceAll('/', '~1')}/src`} editAltField={`/items/@${item.id.replaceAll('~', '~0').replaceAll('/', '~1')}/alt`} editCaptionField={`/items/@${item.id.replaceAll('~', '~0').replaceAll('/', '~1')}/caption`} />
            </div>
          ))}
        </div>
      </Window>
      </div>
    )}

    {(musicPreview.length > 0 || hasWindowOverride('home-music') || getWindowDefinition('home-music')?.enabled === false) && (
      <div class="home-slot home-slot--music">
      <Window windowId="home-music" class="home-music">
        <div class="section-heading"><h2><Icon name="music" size={20} />Music</h2></div>
        <ul class="music-preview">
          {musicPreview.map((track, index) => (
            <li>
              <button type="button" data-play-track={track.id} aria-label={`Play ${track.title}`}>
                <span class="track-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="track-cover">{track.cover ? <img src={track.cover} alt={track.coverAlt} width="40" height="40" loading="lazy" decoding="async" data-site-edit-file="src/content/music.json" data-site-edit-field={`/tracks/@${track.id.replaceAll('~', '~0').replaceAll('/', '~1')}/cover`} data-site-edit-alt-field={`/tracks/@${track.id.replaceAll('~', '~0').replaceAll('/', '~1')}/coverAlt`} data-site-edit-format="image" data-site-edit-label="Track cover" /> : <Icon name="music" size={19} />}</span>
                <span class="track-title" data-site-edit-file="src/content/music.json" data-site-edit-field={`/tracks/@${track.id.replaceAll('~', '~0').replaceAll('/', '~1')}/title`} data-site-edit-format="text" data-site-edit-label="Track title">{track.title}</span>
                <span class="track-play"><Icon name="play" size={15} /><span>Play</span></span>
              </button>
            </li>
          ))}
        </ul>
      </Window>
      </div>
    )}
    </div>
  </div>
</SiteLayout>

<style>
  .home-page, .home-primary, .home-secondary { display: grid; align-items: start; gap: 1.55rem; min-width: 0; }
  .home-slot { min-width: 0; }
  .home-slot:not(:has(> :global(.window:not([hidden])), > :global([data-window-placeholder]:not([hidden])))) { display: none; }
  :global(.home-hero > .window-body) { padding: 0; }
  .hero-inner { position: relative; isolation: isolate; min-height: clamp(140px, 25cqi, 300px); overflow: hidden; }
  .hero-copy { position: relative; max-width: 100%; padding: clamp(.9rem, 3cqi, 2.5rem); }
  .hero-location { display: inline-flex; align-items: center; gap: .6rem; padding: .3rem .55rem; margin-bottom: 1.65rem; border: 1px solid color-mix(in srgb, var(--line) 55%, transparent); background: color-mix(in srgb, var(--surface-raised) 58%, transparent); font-size: 9px; line-height: 1.5; text-transform: uppercase; letter-spacing: .14em; }
  .hero-location > span { display: block; width: 5px; height: 5px; background: var(--accent-ink); }
  h1 { margin: 0 0 1.4rem; font-size: clamp(1.4rem, 6.8cqi, 5.35rem); line-height: 1.1; letter-spacing: -.065em; text-shadow: 2px 3px 0 color-mix(in srgb, var(--surface) 70%, transparent); }
  h1 > .text-caret { color: var(--line); }
  .hero-copy h1:last-child { margin-bottom: 0; }
  .hero-intro { max-width: 43ch; margin-bottom: 1.7rem; font-family: var(--font-reading); font-size: 1rem; line-height: 1.75; white-space: pre-line; }
  .hero-statusbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 26px; padding: .3rem .7rem; border-top: 1px solid var(--line); box-shadow: inset 0 1px var(--bevel-light); color: var(--muted); font-size: 9px; }
  .hero-statusbar > span:first-child { display: inline-flex; align-items: center; gap: .45rem; }
  .hero-statusbar > span:last-child { letter-spacing: .13em; }
  .game-preview { display: grid; gap: 1.75rem; }
  .game-preview__copy { min-width: 0; }
  .game-preview h2 { font-size: clamp(1.1rem, 3cqi, 2rem); margin-bottom: .75rem; }
  .game-status { display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); font-size: 10px; margin-bottom: 1rem; }
  .game-status > span[aria-hidden] { width: 5px; height: 5px; background: var(--accent-ink); }
  .game-description { font-family: var(--font-reading); font-size: .95rem; line-height: 1.75; white-space: pre-line; }
  .game-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.25rem; }
  .game-trailer { display: inline-flex; align-items: center; gap: .45rem; font-size: 10px; }
  .devlog-empty { display: flex; align-items: center; gap: 1.4rem; min-height: 174px; padding: .75rem; }
  .empty-book { display: grid; place-items: center; flex-shrink: 0; width: 64px; height: 70px; border: 1px solid var(--line); background: repeating-linear-gradient(0deg, transparent, transparent 11px, color-mix(in srgb, var(--line) 11%, transparent) 11px, color-mix(in srgb, var(--line) 11%, transparent) 12px), var(--surface-raised); box-shadow: 3px 3px 0 var(--sage); color: var(--muted); }
  .devlog-empty h2 { font-size: 1.2rem; margin: 0 0 .6rem; }
  .devlog-empty p { font-family: var(--font-reading); font-size: .9rem; color: var(--muted); margin: 0 0 .85rem; }
  .devlog-empty a { display: inline-flex; align-items: center; gap: .6rem; font-size: 10px; }
  .recent-posts { border-top: 1px solid var(--line); margin-top: 1.4rem; padding-top: 1.25rem; }
  .recent-posts > h2 { margin: 0 0 .5rem; }
  .recent-posts ul { list-style: none; padding: 0; margin: 0; }
  .recent-posts li + li { border-top: 1px solid color-mix(in srgb, var(--line) 25%, transparent); }
  .recent-posts li a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .35rem .9rem; padding: .8rem 0; text-decoration: none; font-size: 11px; }
  .recent-posts li a:hover > span { text-decoration: underline; }
  .recent-posts time { grid-row: 2; color: var(--muted); font-size: 9px; }
  .recent-posts li svg { grid-row: 1 / 3; grid-column: 2; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; }
  .section-heading h2 { display: flex; align-items: center; gap: .65rem; font-size: 1.25rem; margin: 0; }
  .section-heading > a { display: inline-flex; align-items: center; gap: .5rem; font-size: .65rem; }
  .gallery-preview { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 1rem; }
  .gallery-preview__item { min-width: 0; }
  .gallery-preview__item :global(figure) { margin: 0; }
  .gallery-preview__item :global(img), .gallery-preview__item :global(video) { width: 100%; height: auto; max-height: 320px; object-fit: contain; background: var(--page-bg); }
  .gallery-preview__item h3 { margin: 0 0 .65rem; font-size: .8rem; line-height: 1.55; }
  .music-preview { list-style: none; padding: 0; margin: 0; }
  .music-preview li + li { border-top: 1px solid color-mix(in srgb, var(--line) 35%, transparent); }
  .music-preview button { display: flex; align-items: center; gap: .9rem; width: 100%; min-width: 0; padding: .65rem .4rem; border: 0; background: transparent; text-align: left; }
  .music-preview button:hover { background: color-mix(in srgb, var(--lavender) 25%, transparent); }
  .track-number { color: var(--muted); font-size: 10px; }
  .track-cover { display: grid; place-items: center; flex-shrink: 0; width: 40px; height: 40px; background: var(--lavender); border: 1px solid var(--line); }
  .track-cover img { width: 100%; height: 100%; object-fit: cover; }
  .track-title { font-size: 12px; min-width: 0; overflow-wrap: anywhere; }
  .track-play { display: inline-flex; align-items: center; gap: .5rem; margin-left: auto; padding-left: .5rem; font-size: 10px; }

  /* Named slots keep the authored desktop arrangement when a window is moved. */
  @media screen and (min-width: 1000px) {
    .home-page { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem; padding: .75rem 1rem 2rem; }
    .home-secondary { margin-top: 3rem; }
    .home-slot--journal { margin-left: 2rem; }
    .home-slot--game { margin-right: 2rem; }
    .home-slot--music { margin-inline: 1.5rem .5rem; }
    .hero-inner { min-height: 0; }
    .hero-copy { padding: 1.75rem; }
    .hero-intro { margin-bottom: 1rem; }
  }
  @container window-content (max-width: 700px) {
    .devlog-empty { gap: 1rem; min-height: 140px; padding: .5rem; }
    .empty-book { width: 48px; height: 56px; }
    .gallery-preview { gap: .75rem; }
  }
  @media (max-width: 760px) {
    .home-page, .home-primary, .home-secondary { gap: 1.15rem; }
  }
  @container window-content (max-width: 620px) {
    .hero-location { margin-bottom: 1.1rem; }
    h1 { margin-bottom: 1.25rem; }
    .hero-intro { font-size: .95rem; }
    .gallery-preview { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; }
    .track-play > span { display: none; }
    .music-preview button { gap: .6rem; }
  }
</style>
