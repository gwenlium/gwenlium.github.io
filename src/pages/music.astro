---
import TopicFilter from '../components/TopicFilter.astro';
import { topicOptions } from '../lib/topics.mjs';
import { pages } from '../lib/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import MusicLibrary from '../components/MusicLibrary.astro';
import { tracks } from '../lib/settings';
import { getWindowDefinition } from '../lib/windows';
const showLibrary = Boolean(getWindowDefinition('music-library')?.enabled);
const showCatalogue = Boolean(getWindowDefinition('music-catalogue')?.enabled);
---

<SiteLayout title={pages.music.title}>
  <header class="page-heading">
    <span class="eyebrow" data-site-edit-file="src/content/pages/music.json" data-site-edit-field="/eyebrow" data-site-edit-format="text" data-site-edit-label="Page eyebrow">{pages.music.eyebrow}</span>
    <h1 data-site-edit-file="src/content/pages/music.json" data-site-edit-field="/title" data-site-edit-format="text" data-site-edit-label="Page title">{pages.music.title}</h1>
    {pages.music.intro && <p class="page-intro" data-site-edit-file="src/content/pages/music.json" data-site-edit-field="/intro" data-site-edit-format="text" data-site-edit-label="Page introduction">{pages.music.intro}</p>}
  </header>
  <div class:list={['music-workspace', { 'music-workspace--paired': showLibrary && showCatalogue }]}>
    <div class="music-library-slot" hidden={!showLibrary}><MusicLibrary /></div>
    <div class="music-catalogue-slot" hidden={!showCatalogue}>
  <Window windowId="music-catalogue">
    {tracks.length ? (
      <section data-topic-catalogue="music" aria-label="Music catalogue">
      <TopicFilter topics={topicOptions(tracks)} id="music-topic" />
      <ol class="track-list">
        {tracks.map((track, index) => (
          <li class="track" data-item-topics={JSON.stringify(track.topics)} id={`track-${track.id}`} data-track-row data-track-id={track.id}>
            <span class="track-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class:list={['track-cover', { 'track-cover--empty': !track.cover }]}>
              {track.cover ? <Media src={track.cover} alt={track.coverAlt} sizes="68px" editFile="src/content/music.json" editField={`/tracks/@${track.id.replaceAll('~', '~0').replaceAll('/', '~1')}/cover`} editAltField={`/tracks/@${track.id.replaceAll('~', '~0').replaceAll('/', '~1')}/coverAlt`} editLabel="Track cover" /> : <Icon name="music" size={24} />}
            </div>
            <div class="track-meta"><h2 data-site-edit-file="src/content/music.json" data-site-edit-field={`/tracks/@${track.id.replaceAll('~', '~0').replaceAll('/', '~1')}/title`} data-site-edit-format="text" data-site-edit-label="Track title">{track.title}</h2>{track.topics.length > 0 && <div class="topic-tags">{track.topics.map(topic => <button type="button" class="tag" data-topic-pick={topic}>{topic}</button>)}</div>}<p data-track-state>{track.src ? 'Ready' : 'Audio unavailable'}</p></div>
            <div class="track-actions" role="group" aria-label={`Actions for ${track.title}`}>
              <button type="button" class="button track-play" data-play-track={track.id} aria-label={`Play ${track.title}`} aria-pressed="false" disabled={!track.src}>
                <span data-track-button-label>Play</span>
              </button>
              <button type="button" class="button-secondary" data-track-reaction="like" data-track-id={track.id} aria-label={`Like ${track.title} on this device`} aria-pressed="false">Like</button>
              <button type="button" class="button-secondary" data-track-reaction="dislike" data-track-id={track.id} aria-label={`Dislike ${track.title} on this device`} aria-pressed="false">Dislike</button>
              <button type="button" class="button-secondary" data-share-track data-track-id={track.id} aria-label={`Share ${track.title}`}>Share</button>
              <button type="button" class="button-secondary" data-add-track data-track-id={track.id} aria-label={`Add ${track.title} to a playlist`}>Add</button>
            </div>
          </li>
        ))}
      </ol>
      </section>
    ) : (
      <div class="empty-state">
        <Icon name="music" size={36} />
        <h2>No tracks published yet</h2>
      </div>
    )}
  </Window>
    </div>
  </div>
</SiteLayout>

<style>
  .page-heading p { max-width: 43rem; color: var(--muted); font-family: var(--font-reading); line-height: 1.7; }
  .music-workspace { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.8rem; align-items: start; }
  .music-library-slot, .music-catalogue-slot { min-width: 0; }
  @media screen and (min-width: 1000px) {
    .music-workspace { gap: clamp(1.4rem, 2.5vw, 2.25rem); }
    .music-workspace--paired { grid-template-columns: minmax(17rem, .78fr) minmax(0, 2fr); }
    .music-workspace--paired .music-library-slot { margin-top: 2.5rem; }
    .music-workspace:not(.music-workspace--paired) .music-library-slot { width: min(100%, 32rem); }
  }
  .track-list { list-style: none; margin: 0; padding: 0; }
  .track { display: grid; grid-template-columns: 2ch 68px minmax(0, 1fr); align-items: center; gap: clamp(.75rem, 2cqi, 1rem); padding: clamp(1rem, 3cqi, 1.2rem) .6rem; border-bottom: 1px solid var(--line); }
  .track[hidden] { display: none; }
  .topic-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .6rem; }
  .topic-tags button { min-height: 44px; cursor: pointer; }
  .track:first-child { padding-top: .35rem; }
  .track:last-child { border-bottom: 0; padding-bottom: .35rem; }
  .track:has([aria-current='true']) { background: color-mix(in srgb, var(--sage) 30%, var(--surface)); box-shadow: inset 3px 0 var(--line); }
  .track[data-shared-track] { outline: 2px solid var(--focus); outline-offset: -2px; }
  .track-number { color: var(--muted); font-size: .7rem; flex-shrink: 0; }
  .track-cover { width: 68px; padding: .2rem; background: var(--surface-raised); border: 1px solid var(--line); }
  .track-cover--empty { display: grid; place-items: center; aspect-ratio: 1; color: var(--muted); background: linear-gradient(140deg, var(--sage), var(--lavender)); }
  .track-cover :global(img) { aspect-ratio: 1; object-fit: cover; }
  .track-meta { flex: 1; min-width: 0; }
  .track-meta h2 { font-size: clamp(.8rem, .7rem + .5cqi, .9rem); font-weight: 400; margin: 0; overflow-wrap: anywhere; }
  .track-meta p { margin: .5rem 0 0; font-size: .65rem; color: var(--muted); }
  .track-actions { grid-column: 3; display: flex; flex-wrap: wrap; gap: .45rem; }
  .track-actions button { min-height: 44px; border-radius: 0; }
  .track-play { min-width: 5rem; font: inherit; font-size: .7rem; cursor: pointer; }
  .track-play[aria-pressed='true'], [data-track-reaction][aria-pressed='true'] { background: var(--ink); color: var(--surface); }
  .track-actions button:disabled { opacity: .45; cursor: default; transform: none; }
  .empty-state :global(svg) { margin-inline: auto; }
  @container window-content (max-width: 560px) {
    .track { grid-template-columns: 48px minmax(0, 1fr); gap: .75rem; padding: 1rem .5rem; }
    .track-cover { width: 48px; }
    .track-number { display: none; }
    .track-play { min-width: 3.5rem; padding-inline: .6rem; }
    .track-actions { grid-column: 1 / -1; }
  }
</style>
