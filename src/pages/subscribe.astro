---
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/settings';
const feedUrl = new URL('/rss.xml', Astro.site || 'https://gwenlium.dev').href;
let newsletterUrl = '';
try {
  const url = new URL(site.newsletterUrl);
  const supportedHost = ['follow.it', 'www.follow.it'].includes(url.hostname);
  if (url.protocol === 'https:' && supportedHost && url.pathname.replace(/\//g, '') && !url.username && !url.password) newsletterUrl = url.href;
} catch { /* Email sign-up remains unavailable until a real provider URL is configured. */ }
---

<SiteLayout title="Subscriptions">
  <header class="page-heading">
    <span class="eyebrow">Updates</span>
    <h1>Subscriptions</h1>
  </header>
  <div class="subscribe-grid">
    <Window title="RSS feed" tone="sage">
      <div class="option-heading"><Icon name="rss" size={30} /><span class="tag">No account needed</span></div>
      <h2>RSS</h2>
      <p class="option-description">Add the devlog feed to your RSS reader to receive new published posts. No email address or subscription service required.</p>
      <div class="feed-actions">
        <a class="button" href="/rss.xml">Open RSS feed<Icon name="external" size={14} /></a>
        <button type="button" class="button-secondary" data-copy-feed={feedUrl}>Copy feed address</button>
        <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
      </div>
      <label class="feed-label" for="feed-address">Feed address</label>
      <input id="feed-address" class="feed-address" type="url" value={feedUrl} readonly data-feed-address aria-label="RSS feed address" />
    </Window>
    <Window title="Email updates" tone="pink">
      <div class="option-heading"><Icon name="mail" size={30} /><span class="tag">{newsletterUrl ? 'Via follow.it' : 'Not enabled'}</span></div>
      <h2>Email updates</h2>
      {newsletterUrl ? (
        <>
          <p class="option-description">Subscribe on follow.it for automatic updates when new posts are published. Confirmation, delivery preferences, and unsubscribe options are handled by follow.it.</p>
          <a class="button" href={newsletterUrl}>Subscribe on follow.it<Icon name="external" size={14} /></a>
          <p class="privacy-note">This opens the provider’s hosted sign-up page. This website does not collect or store email addresses.</p>
        </>
      ) : (
        <>
          <p class="option-description">Email subscriptions are not configured. You can follow published posts with the RSS feed instead.</p>
          <p class="privacy-note">No sign-up form is active, and no email addresses are being collected.</p>
        </>
      )}
    </Window>
  </div>
  <a class="back-link" href="/devlog/"><Icon name="book" size={15} />Browse the devlog</a>
</SiteLayout>

<style>
  .subscribe-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem; align-items: start; }
  .option-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.6rem; }
  h2 { font-family: var(--font-reading); font-size: clamp(1.4rem, 2.3vw, 1.85rem); font-weight: 500; line-height: 1.25; margin: 0 0 1rem; }
  .option-description, .privacy-note { font-family: var(--font-reading); line-height: 1.75; color: var(--muted); }
  .option-description { margin: 0 0 1.7rem; }
  .privacy-note { font-size: .85rem; margin: 1.3rem 0 0; }
  .feed-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
  .feed-actions button { font: inherit; font-size: .7rem; cursor: pointer; }
  .copy-status { flex-basis: 100%; font-size: .65rem; line-height: 1.6; margin: 0; }
  .copy-status:empty { display: none; }
  .feed-label { display: block; margin-top: 1.5rem; font-size: .65rem; color: var(--muted); }
  .feed-address { display: block; width: 100%; min-width: 0; box-sizing: border-box; margin-top: .5rem; padding: .75rem; border: 1px solid var(--line); border-top-color: var(--ink); border-left-color: var(--ink); color: var(--ink); background: var(--surface-raised); font-family: var(--font-ui); font-size: .68rem; }
  .feed-address:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .back-link { display: inline-flex; align-items: center; gap: .6rem; margin-top: 2rem; color: var(--muted); font-size: .75rem; text-underline-offset: .25rem; }
  @media (max-width: 820px) { .subscribe-grid { grid-template-columns: 1fr; } }
</style>
