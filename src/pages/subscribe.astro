---
import { pages } from '../lib/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import FollowAttribution from '../components/FollowAttribution.astro';
import { getWindowDefinition } from '../lib/windows';
const showRss = Boolean(getWindowDefinition('subscribe-rss')?.enabled);
const showEmail = Boolean(getWindowDefinition('subscribe-email')?.enabled);
const feedUrl = new URL('/rss.xml', Astro.site || 'https://gwenlium.dev').href;
---

<SiteLayout title={pages.subscribe.title}>
  <header class="page-heading">
    <span class="eyebrow" data-site-edit-file="src/content/pages/subscribe.json" data-site-edit-field="/eyebrow" data-site-edit-format="text" data-site-edit-label="Page eyebrow">{pages.subscribe.eyebrow}</span>
    <h1 data-site-edit-file="src/content/pages/subscribe.json" data-site-edit-field="/title" data-site-edit-format="text" data-site-edit-label="Page title">{pages.subscribe.title}</h1>
    {pages.subscribe.intro && <p class="page-intro" data-site-edit-file="src/content/pages/subscribe.json" data-site-edit-field="/intro" data-site-edit-format="text" data-site-edit-label="Page introduction">{pages.subscribe.intro}</p>}
  </header>
  <div class:list={['subscribe-grid', { 'subscribe-grid--paired': showRss && showEmail }]}>
    <div class="subscribe-rss-slot" hidden={!showRss}>
    <Window windowId="subscribe-rss">
      <div class="option-heading"><Icon name="rss" size={30} /><span class="tag">No account needed</span></div>
      <h2>RSS</h2>
      <p class="option-description" data-site-edit-file="src/content/pages/subscribe.json" data-site-edit-field="/rssDescription" data-site-edit-format="text" data-site-edit-label="RSS description">{pages.subscribe.rssDescription}</p>
      <div class="feed-actions">
        <button type="button" class="button-secondary" data-copy-feed={feedUrl}>Copy feed address</button>
        <a class="button-secondary" href={feedUrl} data-astro-reload>Open RSS XML</a>
        <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
      </div>
      <label class="feed-label" for="feed-address">Feed address</label>
      <input id="feed-address" class="feed-address" type="url" value={feedUrl} readonly data-feed-address aria-label="RSS feed address" />
    </Window>
    </div>
    <div class="subscribe-email-slot" hidden={!showEmail}>
    <Window windowId="subscribe-email">
      <div class="option-heading"><Icon name="mail" size={30} /><span class="tag">follow.it</span></div>
      <SubscribeForm idPrefix="subscribe-form" />
      <FollowAttribution />
    </Window>
    </div>
  </div>
</SiteLayout>

<style>
  .subscribe-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.8rem; align-items: start; }
  .subscribe-rss-slot, .subscribe-email-slot { min-width: 0; }
  .option-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: clamp(1rem, 4cqi, 1.6rem); }
  h2 { font-family: var(--font-reading); font-size: clamp(1.4rem, 1.1rem + 2cqi, 1.85rem); font-weight: 500; line-height: 1.25; margin: 0 0 1rem; }
  .option-description, .privacy-note { font-family: var(--font-reading); line-height: 1.75; color: var(--muted); }
  .option-description { margin: 0 0 clamp(1rem, 4cqi, 1.7rem); }
  .privacy-note { font-size: .85rem; margin: 1.3rem 0 0; }
  .feed-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
  .feed-actions button { font: inherit; font-size: .7rem; cursor: pointer; }
  .copy-status { flex-basis: 100%; font-size: .65rem; line-height: 1.6; margin: 0; }
  .copy-status:empty { display: none; }
  .feed-label { display: block; margin-top: clamp(1rem, 4cqi, 1.5rem); font-size: .65rem; color: var(--muted); }
  .feed-address { display: block; width: 100%; min-width: 0; box-sizing: border-box; margin-top: .5rem; padding: .75rem; border: 1px solid var(--line); border-top-color: var(--ink); border-left-color: var(--ink); color: var(--ink); background: var(--surface-raised); font-family: var(--font-ui); font-size: .68rem; }
  .feed-address:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  @media screen and (min-width: 1000px) {
    .subscribe-grid { width: min(100%, 58rem); margin-inline: auto; gap: clamp(1.8rem, 3vw, 3rem); }
    .subscribe-grid--paired { grid-template-columns: minmax(17rem, 21rem) minmax(0, 34rem); }
    .subscribe-grid--paired .subscribe-email-slot { margin-top: 4rem; }
    .subscribe-grid:not(.subscribe-grid--paired) .subscribe-rss-slot { width: min(100%, 24rem); }
    .subscribe-grid:not(.subscribe-grid--paired) .subscribe-email-slot { width: min(100%, 34rem); margin-inline: auto; }
  }
</style>
