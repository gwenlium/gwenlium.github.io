---
interface Props {
  text: string;
  caretClass?: string;
}

const { text, caretClass } = Astro.props;
---

<span data-typewriter>{text}<span class:list={['text-caret', caretClass]} aria-hidden="true">|</span></span>

<script>
  import '../scripts/typewriter';
</script>

<style is:global>
  ::highlight(gwenlium-untyped) { color: transparent; background-color: transparent; text-shadow: none; text-decoration-color: transparent; }
  [data-typing] .text-caret { visibility: hidden; }
  .typing-cursor { position: fixed; inset: auto; z-index: 2147483646; width: 2px; margin: 0; padding: 0; border: 0; background: currentColor; pointer-events: none; user-select: none; animation: text-caret-blink 1s step-end infinite; }
  .typing-cursor[hidden] { display: none !important; }
  .typing-cursor::backdrop { background: transparent; pointer-events: none; }
  @media print { .typing-cursor { display: none !important; } }
</style>

