<script>
  import { ownerHintKey } from '../lib/editor-config';

  // Visitors never download the editor. It loads for a browser that signed in before,
  // on the writing page, or when the owner asks for it (Ctrl+Alt+E or ?edit=1).
  let loading: Promise<typeof import('../scripts/editor/owner')> | undefined;
  const load = (interactive: boolean) => {
    loading ??= import('../scripts/editor/owner');
    loading.then(module => module.startOwner(interactive)).catch(() => { loading = undefined; });
  };
  const remembered = () => {
    try { return localStorage.getItem(ownerHintKey) === '1'; } catch { return false; }
  };
  document.addEventListener('keydown', event => {
    if (event.ctrlKey && event.altKey && !event.metaKey && !event.shiftKey && event.code === 'KeyE') {
      event.preventDefault();
      load(true);
    }
  });
  document.addEventListener('astro:page-load', () => {
    const url = new URL(location.href);
    if (url.searchParams.get('edit') === '1') {
      url.searchParams.delete('edit');
      history.replaceState(history.state, '', url);
      load(true);
    } else if (remembered() || url.pathname.startsWith('/write')) load(false);
  });
</script>
