---
import manifest from '../generated/media.json';
import registry from '../content/media-previews.json';

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  type?: 'image' | 'video' | 'audio';
  poster?: string;
  eager?: boolean;
  sizes?: string;
  loop?: boolean;
  muted?: boolean;
  /** For thumbnails: show an animation's still first frame (opening it still plays the animation). */
  still?: boolean;
  editFile?: string;
  editField?: string;
  editAltField?: string;
  editCaptionField?: string;
  editLabel?: string;
}

interface ImageVariant { src: string; width: number }
interface ImageRecord {
  width: number;
  height: number;
  src: string;
  sources: { avif: ImageVariant[]; webp: ImageVariant[] };
  /** The variants are an animation's still first frame (see scripts/prepare-media.mjs). */
  still?: boolean;
}

const { src, alt = '', caption = '', type = 'image', poster = '', eager = false, loop = false, muted = false, still = false } = Astro.props;
const { editFile, editField, editAltField, editCaptionField, editLabel = 'Image' } = Astro.props;
let sourceKey = src;
try { sourceKey = decodeURIComponent(new URL(src, Astro.site || 'https://gwenlium.dev').pathname); }
catch { /* Keep malformed escape sequences as authored. */ }
const images = manifest as Record<string, ImageRecord>;
const record = images[src] || (src.startsWith('/media/') ? images[sourceKey] : undefined);
// An animation's variants are still frames: use them only where a still was asked for.
const image = record?.still && !still ? undefined : record;
const frame = record?.still && still ? record.sources.webp.at(-1)?.src : undefined;
// A prepared animation: a looping, muted video without controls (like a GIF).
const animation = type === 'video' ? (registry.files as Record<string, { loop?: boolean; poster?: string; width?: number; height?: number }>)[src] : undefined;
const animated = animation?.loop === true;
// The still a video shows before it plays; without one, load just enough to show its first frame.
const videoPoster = poster || animation?.poster || '';
const srcset = (variants: ImageVariant[]) => variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
const sizes = Astro.props.sizes || '(max-width: 720px) 100vw, (max-width: 1400px) 85vw, 1200px';
---

{src && (
  <figure class:list={['media', `media--${type}`]}>
    {type === 'image' ? (
      <picture>
        {image?.sources.avif.length ? <source type="image/avif" srcset={srcset(image.sources.avif)} sizes={sizes} /> : null}
        {image?.sources.webp.length ? <source type="image/webp" srcset={srcset(image.sources.webp)} sizes={sizes} /> : null}
        <img
          data-site-edit-file={editFile}
          data-site-edit-field={editField}
          data-site-edit-alt-field={editAltField}
          data-site-edit-format={editFile && editField ? 'image' : undefined}
          data-site-edit-label={editFile && editField ? editLabel : undefined}
          src={frame || image?.src || src}
          alt={alt}
          width={image?.width}
          height={image?.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
          draggable="false"
          data-zoom
          data-full-src={image?.src || src}
          data-zoom-caption={caption}
        />
      </picture>
    ) : animated ? (
      <video class="media-animation" src={src} poster={poster || animation?.poster} width={animation?.width} height={animation?.height}
        autoplay muted loop playsinline preload="metadata" disablepictureinpicture draggable="false" aria-label={alt || caption || 'Animation'} data-animation></video>
    ) : type === 'video' ? (
      <div class="media-video">
        <video
          src={src}
          poster={videoPoster || undefined}
          width={animation?.width}
          height={animation?.height}
          controls
          controlslist="nodownload"
          draggable="false"
          playsinline
          preload={videoPoster ? 'none' : 'metadata'}
          loop={loop}
          muted={muted}
          aria-label={alt || caption || 'Video'}
          data-media-video
        >
          Your browser does not support this video. <a href={src}>Download the video</a>.
        </video>
        <button
          type="button"
          class="media-expand button-secondary"
          data-zoom-video={src}
          data-zoom-caption={caption}
          data-zoom-alt={alt}
          data-zoom-poster={videoPoster}
          aria-haspopup="dialog"
          aria-label={`Expand video${alt ? `: ${alt}` : ''}`}
        >Expand video</button>
      </div>
    ) : (
      <audio src={src} controls preload="none" aria-label={alt || caption || 'Audio'}>
        Your browser does not support audio. <a href={src}>Download the audio</a>.
      </audio>
    )}
    {caption && <figcaption data-site-edit-file={editFile} data-site-edit-field={editCaptionField} data-site-edit-format={editFile && editCaptionField ? 'text' : undefined} data-site-edit-label={editFile && editCaptionField ? 'Media description' : undefined}>{caption}</figcaption>}
  </figure>
)}

<style>
  .media { margin: 0; min-width: 0; }
  .media :global(picture), .media :global(img), .media video { display: block; width: 100%; }
  .media :global(img), .media video { height: auto; border-radius: 2px; }
  .media audio { display: block; width: 100%; }
  .media-video { position: relative; }
  .media-expand { margin-top: .6rem; font: inherit; font-size: .7rem; cursor: pointer; }
  figcaption { margin-top: .65rem; color: var(--muted); font-family: var(--font-reading); font-size: .88rem; line-height: 1.6; white-space: pre-line; overflow-wrap: anywhere; }
</style>
