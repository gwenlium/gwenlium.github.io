  image: 'M3 3h18v18H3ZM3 16l6-6 5 5 3-3 4 4M16 7h.01',
  music: 'M9 18V5l11-2v13M9 8l11-2M9 18c0 2-2 3-4 3s-3-1-3-2 2-3 4-3 3 1 3 2ZM20 16c0 2-2 3-4 3s-3-1-3-2 2-3 4-3 3 1 3 2Z',
  user: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21v-2a8 8 0 0 1 16 0v2',
  rss: 'M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 19h.01',
  settings: 'M9 3h6l1 4 4 1v6l-4 1-1 4H9l-1-4-4-1V8l4-1ZM15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  arrow: 'M4 12h16M13 5l7 7-7 7',
  star: 'm12 2 3 6 7 1-5 5 1 8-6-4-6 4 1-8-5-5 7-1Z',
  close: 'm6 6 12 12M6 18 18 6',
  play: 'm8 4 13 8-13 8Z',
  pause: 'M7 4v16M17 4v16',
  search: 'M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0ZM15 15l6 6',
  mail: 'M3 5h18v14H3ZM3 6l9 7 9-7',
  external: 'M14 3h7v7M21 3 10 14M10 3H3v18h18v-7',
  chevron: 'm9 5 7 7-7 7',
