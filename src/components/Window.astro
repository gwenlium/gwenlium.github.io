---
import { getWindowDefinition } from '../lib/windows';
import WindowFrame from './WindowFrame.astro';

interface Props {
  windowId: string;
  class?: string;
}

const { windowId, class: className } = Astro.props;
const definition = getWindowDefinition(windowId);
const hasTitlebarActions = Astro.slots.has('titlebar-actions');
---

{definition && (definition.enabled ? (
  <WindowFrame definition={definition} class={className} hasTitlebarActions={hasTitlebarActions}>
    <slot />
    <slot name="titlebar-actions" slot="titlebar-actions" />
  </WindowFrame>
) : (
  <template data-site-editor-window={definition.id}>
    <WindowFrame definition={definition} class={className} hasTitlebarActions={hasTitlebarActions}>
      <slot />
      <slot name="titlebar-actions" slot="titlebar-actions" />
    </WindowFrame>
  </template>
))}
