---
import { pages } from '../lib/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import GameOverview from './GameOverview.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, postSearchText, postUrl } from '../lib/content';

interface Props { section: 'devlog' | 'life' }
const { section } = Astro.props;
const page = pages[section];
const title = page.title;
const archiveUrl = `/${section}/`;
const posts = await getPosts(section);
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'en'));
const searchIndex = posts.map((post) => ({
  id: post.data.permalink,
  date: post.data.date.toISOString(),
  title: post.data.title,
  url: postUrl(post),
  kind: 'post',
  tags: post.data.tags,
  text: postSearchText(post),
}));
const indexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<SiteLayout title={title}>
  <header class="page-heading archive-heading">
    <div><p class="eyebrow" data-site-edit-file={`src/content/pages/${section}.json`} data-site-edit-field="/eyebrow" data-site-edit-format="text" data-site-edit-label="Page eyebrow">{page.eyebrow}</p><h1 data-site-edit-file={`src/content/pages/${section}.json`} data-site-edit-field="/title" data-site-edit-format="text" data-site-edit-label="Page title">{title}</h1>{page.intro && <p class="page-intro" data-site-edit-file={`src/content/pages/${section}.json`} data-site-edit-field="/intro" data-site-edit-format="text" data-site-edit-label="Page introduction">{page.intro}</p>}</div>
  </header>

  <div class:list={['journal-archive', `journal-archive--${section}`]} data-devlog data-archive-url={archiveUrl}>
    <div class="archive-tools">
      {section === 'devlog' && <GameOverview />}
      <div class="archive-slot archive-search">
    <Window windowId={`${section}-search`}>
      <form class="search-form" role="search" action={archiveUrl} method="get" data-search-form>
        <label for="devlog-query">Search entries</label>
        <div class="search-row">
          <div class="search-input"><Icon name="search" size={17} /><input id="devlog-query" name="q" type="search" autocomplete="off" maxlength="2048" placeholder="Titles, tags, and article text…" aria-controls="devlog-results" aria-describedby="devlog-search-help" /></div>
          <button class="button" type="submit">Search</button>
          <button class="button button-secondary" type="button" data-clear hidden>Clear</button>
        </div>
        <div class="archive-controls">
          <label>Year<select name="year" aria-controls="devlog-results"><option value="">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
          <label>Order<select name="sort" aria-controls="devlog-results"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label>
        </div>
      </form>
      {tags.length > 0 && <nav class="tag-filters" aria-label="Filter entries by tag">
        <a href={archiveUrl} class="tag" data-tag="" aria-current="true">All entries</a>
        {tags.map((tag) => <a class="tag" href={`${archiveUrl}?tag=${encodeURIComponent(tag)}`} data-tag={tag}>{tag}</a>)}
      </nav>}
      <p class="result-count" role="status" aria-live="polite" aria-atomic="true" data-result-count>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</p>
      <noscript><p class="search-note">Search, filters, sorting, and pagination need JavaScript. All published entries are listed below.</p></noscript>
      <p class="search-note" id="devlog-search-help">Search titles and text, including typos and partial words. Use quotes for an exact phrase or a minus sign to exclude a word.</p>
    </Window>
      </div>
    </div>

    <div class="archive-slot archive-entries">
    <Window windowId={`${section}-entries`}>
      <div id="devlog-results" class="post-list" tabindex="-1" aria-label="Journal entries">
        {posts.map((post) => <div class="post-result" data-post-id={post.data.permalink}><PostCard post={post} /></div>)}
      </div>
      <nav class="archive-pagination" aria-label="Entry pages" data-pagination hidden></nav>
      {posts.length === 0 && <div class="empty-state archive-empty">
        <Icon name="book" size={36} /><h2>No entries published yet.</h2>
      </div>}
      <div class="empty-state archive-empty" data-no-results hidden>
        <Icon name="search" size={32} /><h2>No matching entries.</h2><p>Try another search or clear the filters.</p>
        <button class="button button-secondary" type="button" data-clear>Clear filters</button>
      </div>
    </Window>
    </div>
    <script id="devlog-search-index" type="application/json" is:inline set:html={indexJson} />
  </div>
</SiteLayout>

<script>
  import { paginateArchive, pageNumbers } from '../lib/archive-pagination.mjs';
  import { createSearchIndex } from '../lib/search';
  import type { SearchEntry } from '../lib/search-types';
  let searchController: AbortController | undefined;

  function initializeSearch() {
    searchController?.abort();
    const root = document.querySelector<HTMLElement>('[data-devlog]');
    if (!root) return;
    const form = root.querySelector<HTMLFormElement>('[data-search-form]');
    const input = form?.querySelector<HTMLInputElement>('input[name="q"]');
    const clearSearch = form?.querySelector<HTMLButtonElement>('[data-clear]');
    const yearInput = form?.querySelector<HTMLSelectElement>('[name=year]');
    const sortInput = form?.querySelector<HTMLSelectElement>('[name=sort]');
    const pagination = root.querySelector<HTMLElement>('[data-pagination]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const empty = root.querySelector<HTMLElement>('[data-no-results]');
    const resultList = root.querySelector<HTMLElement>('#devlog-results');
    const searchData = root.querySelector<HTMLScriptElement>('#devlog-search-index');
    if (!yearInput || !sortInput || !pagination || !form || !input || !clearSearch || !count || !empty || !resultList || !searchData) return;
    searchController = new AbortController();
    const { signal } = searchController;
    const clears = root.querySelectorAll<HTMLButtonElement>('[data-clear]');
    const filters = root.querySelectorAll<HTMLAnchorElement>('[data-tag]');
    const results = resultList.querySelectorAll<HTMLElement>('[data-post-id]');
    const index: (SearchEntry & { date: string })[] = JSON.parse(searchData.textContent || '[]');
    const search = createSearchIndex(index);
    const dates = new Map(index.map((entry) => [entry.id, entry.date]));
    const cards = new Map(Array.from(results, (element) => [element.dataset.postId, element]));
    let editingSearch = false;

    const synchronize = () => {
      const parameters = new URL(location.href).searchParams;
      const query = parameters.get('q') ?? '';
      const tag = parameters.get('tag') ?? '';
      const year = parameters.get('year') ?? '';
      const sort = parameters.get('sort') === 'oldest' ? 'oldest' : 'newest';
      yearInput.value = year;
      sortInput.value = sort;
      input.value = query;
      const matches = search.search(query, 'post').filter((entry) => !tag || entry.tags.includes(tag));
      const page = paginateArchive(matches.map((entry) => ({ ...entry, date: dates.get(entry.id)! })), { year, sort, page: parameters.get('page') });
      const matchedIds = new Set(page.entries.map((entry) => entry.id));
      results.forEach((result) => { result.hidden = !matchedIds.has(result.dataset.postId!); });
      for (const match of page.entries) {
        const card = cards.get(match.id);
        if (card) resultList.append(card);
      }
      const visible = page.total;
      count.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}${query || tag ? ' found' : ''}${tag ? ` tagged ${tag}` : ''}${year ? ` in ${year}` : ''}${visible ? ` ${page.start}–${page.end} Page ${page.page} of ${page.pages}` : ''}`;
      empty.hidden = visible > 0 || index.length === 0;
      clearSearch.hidden = !query && !tag && !year;
      pagination.hidden = page.pages <= 1;
      pagination.replaceChildren();
      const addPage = (number: number, label: string, current = false) => {
        const link = document.createElement('a');
        link.className = 'button button-secondary';
        const target = new URL(location.href);
        target.searchParams.set('page', String(number));
        link.href = target.pathname + target.search;
        link.dataset.page = String(number);
        link.textContent = label;
        link.setAttribute('aria-label', label === String(number) ? `Page ${number}` : label);
        if (current) link.setAttribute('aria-current', 'page');
        pagination.append(link);
      };
      if (page.page > 1) addPage(page.page - 1, 'Previous');
      for (const number of pageNumbers(page.page, page.pages)) {
        if (number === null) { const gap = document.createElement('span'); gap.textContent = '…'; gap.setAttribute('aria-hidden', 'true'); pagination.append(gap); }
        else addPage(number, String(number), number === page.page);
      }
      if (page.page < page.pages) addPage(page.page + 1, 'Next');
      filters.forEach((filter) => {
        if (filter.dataset.tag === tag) filter.setAttribute('aria-current', 'true');
        else filter.removeAttribute('aria-current');
        const target = new URL(location.href);
        target.searchParams.delete('page');
        target.searchParams.delete('tag');
        if (query) target.searchParams.set('q', query);
        if (filter.dataset.tag) target.searchParams.set('tag', filter.dataset.tag);
        filter.href = `${target.pathname}${target.search}`;
      });
    };

    const setFilters = (query: string, tag: string, replace = false) => {
      const url = new URL(location.href);
      url.searchParams.delete('page');
      yearInput.value ? url.searchParams.set('year', yearInput.value) : url.searchParams.delete('year');
      sortInput.value === 'oldest' ? url.searchParams.set('sort', 'oldest') : url.searchParams.delete('sort');
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
      if (url.href !== location.href) {
        // Keep Astro's router state, so browser Back also works across page transitions.
        if (replace) history.replaceState(history.state, '', url);
        else history.pushState(history.state, '', url);
      }
      synchronize();
    }

    for (const select of [yearInput, sortInput]) select.addEventListener('change', () => {
      setFilters(input.value, new URL(location.href).searchParams.get('tag') ?? '');
      editingSearch = false;
    }, { signal });
    pagination.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-page]');
      if (!link) return;
      event.preventDefault();
      history.pushState(history.state, '', link.href);
      synchronize();
      resultList.focus({ preventScroll: true });
      resultList.scrollIntoView({ block: 'start', behavior: 'instant' });
      editingSearch = false;
    }, { signal });
    input.addEventListener('input', () => {
      setFilters(input.value, new URL(location.href).searchParams.get('tag') ?? '', editingSearch);
      editingSearch = true;
    }, { signal });
    input.addEventListener('blur', () => { editingSearch = false; }, { signal });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      setFilters(input.value, new URL(location.href).searchParams.get('tag') ?? '');
      editingSearch = false;
    }, { signal });
    filters.forEach((filter) => filter.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      setFilters(input.value, filter.dataset.tag ?? '');
      editingSearch = false;
    }, { signal }));
    clears.forEach((clear) => clear.addEventListener('click', () => {
      yearInput.value = '';
      setFilters('', '');
      editingSearch = false;
      input.focus();
    }, { signal }));
    window.addEventListener('popstate', () => {
      editingSearch = false;
      if (location.pathname === root.dataset.archiveUrl) synchronize();
    }, { signal });
    synchronize();
  }

  document.addEventListener('astro:page-load', initializeSearch);
  document.addEventListener('astro:before-swap', () => searchController?.abort());
  initializeSearch();
</script>

<style>
  .archive-controls { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
  .archive-controls label { flex: 1 1 10rem; }
  .archive-controls select { display: block; width: 100%; min-height: 44px; margin-top: .5rem; padding: .5rem; background: var(--page-bg); color: var(--ink); border: 1px solid var(--line); font: inherit; }
  .archive-pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .5rem; margin-top: 1.5rem; }
  .archive-pagination :global(a) { min-width: 44px; min-height: 44px; justify-content: center; }
  .archive-pagination :global([aria-current=page]) { background: var(--sage); color: var(--ink); outline: 2px solid var(--ink); outline-offset: 1px; }
  [data-pagination][hidden] { display: none; }
  .tag-filters a { min-height: 44px; display: inline-flex; align-items: center; }
  .archive-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .journal-archive, .archive-tools { display: grid; align-items: start; gap: 1.5rem; min-width: 0; }
  .archive-slot { min-width: 0; }
  .archive-tools:not(:has(:global(:is([data-desktop-window], [data-window-placeholder])))), .archive-slot:not(:has(:global(:is([data-desktop-window], [data-window-placeholder])))) { display: none; }
  .search-form label { display: block; margin-bottom: .65rem; font-size: .75rem; }
  .search-row { display: flex; align-items: stretch; flex-wrap: wrap; gap: .65rem; }
  .search-input { display: flex; flex: 1 1 16rem; min-width: 0; gap: .65rem; align-items: center; background: var(--page-bg); border: 1px solid var(--line); box-shadow: inset 1px 1px 2px rgb(0 0 0 / .08); padding: 0 .8rem; }
  .search-input input { width: 100%; min-width: 0; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: .8rem; padding: .85rem 0; }
  .search-input:focus-within { outline: 2px solid var(--ink); outline-offset: 3px; }
  .search-input input:focus { outline: none; }
  .tag-filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1.1rem; }
  .tag-filters [aria-current] { background: var(--sage); color: var(--ink); box-shadow: inset 1px 1px 2px rgb(0 0 0 / .15); }
  .result-count { font-size: .7rem; color: var(--muted); margin: 1rem 0 0; }
  .post-result { border-bottom: 1px solid var(--line); padding: 1.6rem 0; }
  .post-result:first-child { padding-top: 0; }
  .post-result:last-child { padding-bottom: 0; border-bottom: 0; }
  .post-result[hidden], [data-no-results][hidden], [data-clear][hidden] { display: none; }
  .archive-empty { text-align: center; padding: 3rem 1rem; }
  .archive-empty :global(svg) { margin: 0 auto 1rem; opacity: .65; }
  .archive-empty h2 { font-size: 1rem; }
  .archive-empty p, .search-note { font-family: var(--font-reading); color: var(--muted); }
  @media screen and (min-width: 1000px) {
    .journal-archive { column-gap: clamp(1.5rem, 3vw, 2.5rem); }
    .journal-archive--devlog { grid-template-columns: minmax(17rem, 22rem) minmax(0, 1fr); }
    .journal-archive--devlog .archive-tools { display: contents; }
    .journal-archive--devlog :global(.game-overview) { grid-column: 1; grid-row: 1 / 3; }
    .journal-archive--devlog .archive-search { grid-column: 2; grid-row: 1; margin: 2rem 0 0 3rem; }
    .journal-archive--devlog .archive-entries { grid-column: 2; grid-row: 2; }
    .journal-archive--life { grid-template-columns: minmax(0, 1fr) minmax(16rem, 19rem); max-width: 70rem; margin-inline: auto; }
    .journal-archive--life .archive-tools { grid-column: 2; grid-row: 1; margin-top: 4.5rem; }
    .journal-archive--life .archive-entries { grid-column: 1; grid-row: 1; }
    .journal-archive:not(:has(.archive-tools :global(:is([data-desktop-window], [data-window-placeholder])))) { grid-template-columns: minmax(0, 1fr); }
    .journal-archive:not(:has(.archive-tools :global(:is([data-desktop-window], [data-window-placeholder])))) .archive-entries { grid-column: 1; width: 100%; max-width: 52rem; margin: 0 auto; }
  }
</style>
