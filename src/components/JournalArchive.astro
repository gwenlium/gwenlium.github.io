---
import { pages } from '../lib/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import GameOverview from './GameOverview.astro';
import EntryArchive from './EntryArchive.astro';

interface Props { section: 'devlog' | 'life' }
const { section } = Astro.props;
const page = pages[section];
const title = page.title;
---

<SiteLayout title={title}>
  <header class="page-heading archive-heading">
    <div><p class="eyebrow" data-site-edit-file={`src/content/pages/${section}.json`} data-site-edit-field="/eyebrow" data-site-edit-format="text" data-site-edit-label="Page eyebrow">{page.eyebrow}</p><h1 data-site-edit-file={`src/content/pages/${section}.json`} data-site-edit-field="/title" data-site-edit-format="text" data-site-edit-label="Page title">{title}</h1>{page.intro && <p class="page-intro" data-site-edit-file={`src/content/pages/${section}.json`} data-site-edit-field="/intro" data-site-edit-format="text" data-site-edit-label="Page introduction">{page.intro}</p>}</div>
  </header>
  <EntryArchive section={section} showEmpty>
    <Fragment slot="tools">{section === 'devlog' && <GameOverview />}</Fragment>
  </EntryArchive>
</SiteLayout>

<style>
  .archive-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
</style>
