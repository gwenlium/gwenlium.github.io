---
import { tracks } from '../lib/settings';
import manifest from '../generated/media.json';
import Icon from './Icon.astro';

interface ImageVariant { src: string; width: number }
interface ImageRecord { sources: { avif: ImageVariant[]; webp: ImageVariant[] } }
const images = manifest as Record<string, ImageRecord>;
const thumbnail = (src: string) => {
  let sourceKey = src;
  try { sourceKey = decodeURIComponent(new URL(src, Astro.site || 'https://gwenlium.dev').pathname); }
  catch { /* Keep malformed escape sequences as authored. */ }
  const image = images[src] || (src.startsWith('/media/') ? images[sourceKey] : undefined);
  const variants = image?.sources.webp.length ? image.sources.webp : image?.sources.avif;
  if (!variants?.length) return src;
  const suitable = variants.filter((variant) => variant.width >= 112);
  return (suitable.length ? suitable : variants).reduce((smallest, variant) => variant.width < smallest.width ? variant : smallest).src;
};
const queueTracks = tracks.map((track) => ({ ...track, cover: thumbnail(track.cover) }));
const availableTracks = queueTracks.filter((track) => track.src);
const firstTrack = availableTracks[0];
const emptyMessage = tracks.length ? 'No playable tracks' : 'No tracks published';
---

<gwenlium-player transition:persist="site-player" data-tracks={JSON.stringify(availableTracks)} data-presentation="horizontal" data-player-state="open" data-player-maximized="false" data-playing="false">
  <audio preload="none" aria-label="Music player" data-player-audio></audio>
  <section id="music-player" class="player-window" aria-labelledby="music-window-title" tabindex="-1" data-desktop-window data-persistent-window data-window-id="music-player" data-window-title="Music" data-window-state="normal">
    <header class="player-titlebar">
      <span id="music-window-title" class="player-window-title"><Icon name="music" size={14} />Music</span>
      <label class="player-presentation"><span>View</span><select data-player-presentation aria-label="Music player presentation"><option value="horizontal">Horizontal</option><option value="vertical">Vertical</option><option value="left">Left dock</option></select></label>
      <div class="player-window-controls" role="group" aria-label="Music window controls">
        <button type="button" class="player-button player-window-control" data-player-minimize aria-label="Collapse Music" title="Collapse Music"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12h10" /></svg></button>
        <button type="button" class="player-button player-window-control" data-player-maximize aria-label="Maximize Music" title="Maximize Music" aria-pressed="false"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path data-player-maximize-icon d="M3 3h10v10H3zM3 5.5h10" /></svg></button>
        <button type="button" class="player-button player-window-control player-window-close" data-player-close aria-label="Close Music" title="Close Music"><Icon name="close" size={14} /></button>
      </div>
    </header>
    <div class="player-body">
      <div class="player-content">
        <div class="player-track">
      <div class="player-cover" aria-hidden="true">
        <img data-player-cover src={firstTrack?.cover || undefined} alt="" width="56" height="56" decoding="async" hidden={!firstTrack?.cover} />
        <span data-player-cover-fallback hidden={Boolean(firstTrack?.cover)}><Icon name="music" size={24} /></span>
      </div>
      <div class="player-meta">
        <span class="player-caption">Current track</span>
        <span class="player-title" data-player-title title={firstTrack?.title}>{firstTrack?.title || 'No playable tracks'}</span>
        <span data-player-status class="player-status" role="status" aria-live="polite">{firstTrack ? 'Not playing' : emptyMessage}</span>
      </div>
    </div>
    <div class="player-transport" role="group" aria-label="Playback controls">
      <button type="button" class="player-button player-skip" data-player-previous aria-label="Previous track" disabled={availableTracks.length < 2}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4v16M19 4 7 12l12 8Z" /></svg>
      </button>
      <button type="button" data-player-toggle aria-label={firstTrack ? `Play ${firstTrack.title}` : 'Play music'} class="player-button player-toggle" disabled={!firstTrack}>
        <span data-player-play><Icon name="play" size={20} /></span>
        <span data-player-pause hidden><Icon name="pause" size={20} /></span>
      </button>
      <button type="button" class="player-button player-skip" data-player-next aria-label="Next track" disabled={availableTracks.length < 2}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 4v16M5 4l12 8-12 8Z" /></svg>
      </button>
    </div>
    <div class="player-seek">
      <label for="player-progress" class="sr-only">Track position</label>
      <input id="player-progress" data-player-seek type="range" min="0" max="0" step="0.1" value="0" disabled />
      <span class="player-time" data-player-time aria-hidden="true">0:00 / 0:00</span>
    </div>
    <div class="player-tools">
      <div class="player-volume player-volume--dock">
        <label for="player-volume">Vol</label>
        <input id="player-volume" data-player-volume type="range" min="0" max="1" step="0.05" value="0.65" aria-label="Music volume" disabled={!firstTrack} />
      </div>
      <button type="button" class="player-button player-queue-toggle" data-player-queue-toggle aria-label="Open queue" aria-controls="player-queue" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 5h18M3 10h18M3 15h9M3 20h9m5-6 5 3-5 3Z" /></svg>
        <span class="player-queue-label">Queue</span>
      </button>
    </div>
  </div>
  <section id="player-queue" class="player-queue" data-player-queue aria-labelledby="player-queue-title" hidden>
    <header class="player-queue-header">
      <div><h2 id="player-queue-title">Queue</h2><span>{tracks.length} {tracks.length === 1 ? 'track' : 'tracks'}</span></div>
      <button type="button" class="player-button player-queue-close" data-player-queue-close aria-label="Close queue"><Icon name="close" size={16} /></button>
    </header>
    {queueTracks.length ? (
      <ol class="player-queue-list">
        {queueTracks.map((track, index) => (
          <li>
            <button type="button" class="player-queue-track" data-play-track={track.id} aria-label={`Play ${track.title}`} aria-pressed="false" disabled={!track.src}>
              <span class="player-queue-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="player-queue-cover" aria-hidden="true">
                {track.cover ? <img src={track.cover} alt="" width="42" height="42" loading="lazy" decoding="async" /> : <Icon name="music" size={20} />}
              </span>
              <span class="player-queue-meta"><span class="player-queue-title">{track.title}</span><span class="player-track-state" data-track-state>{track.src ? 'Ready' : 'Audio unavailable'}</span></span>
              {track.src && <span class="player-queue-action" data-track-button-label>Play</span>}
            </button>
          </li>
        ))}
      </ol>
    ) : <p class="player-queue-empty">No tracks published yet.</p>}
    <div class="player-queue-footer">
      <label class="player-autoplay"><input type="checkbox" data-player-autoplay />Autoplay next track</label>
      <span class="player-autoplay-status" data-autoplay-status role="status"></span>
      <div class="player-volume">
        <label for="player-queue-volume">Volume</label>
        <input id="player-queue-volume" data-player-volume type="range" min="0" max="1" step="0.05" value="0.65" aria-label="Music volume" disabled={!firstTrack} />
        <output data-player-volume-value for="player-queue-volume">65%</output>
      </div>
    </div>
  </section>
    </div>
  </section>
  <div class="player-rail" data-player-rail hidden>
    <button type="button" class="player-button player-reopen" data-player-reopen aria-controls="music-player" aria-expanded="false"><Icon name="music" size={18} /><span>Open Music</span><span class="player-activity" aria-hidden="true"></span></button>
    <span class="player-rail-status" data-player-rail-status role="status" aria-live="polite">{firstTrack ? 'Not playing' : emptyMessage}</span>
  </div>
</gwenlium-player>

<script>
  import { animateWindow, cancelWindowAnimation } from '../scripts/window-motion';

  type PlayerPresentation = 'horizontal' | 'vertical' | 'left';
  type PlayerVisibility = 'open' | 'collapsed' | 'closed';
  type WindowCommand = { id?: string; action?: 'restore' | 'maximize' | 'minimize' | 'close' | 'restore-all' };
  interface PlayerTrack { id: string; title: string; src: string; cover: string; coverAlt: string }

  class GwenliumPlayer extends HTMLElement {
    private initialized = false;
    private tracks: PlayerTrack[] = [];
    private index = 0;
    private request = 0;
    private userInitiated = false;
    private autoplayNext = false;
    private actuallyPlaying = false;
    private audio!: HTMLAudioElement;
    private toggle!: HTMLButtonElement;
    private seek!: HTMLInputElement;
    private volumes!: NodeListOf<HTMLInputElement>;
    private status!: HTMLElement;
    private titleText!: HTMLElement;
    private cover!: HTMLImageElement;
    private coverFallback!: HTMLElement;
    private time!: HTMLElement;
    private queue!: HTMLElement;
    private queueToggle!: HTMLButtonElement;
    private pageEvents?: AbortController;
    private panelObserver?: ResizeObserver;
    private measureFrame = 0;
    private presentation: PlayerPresentation = 'horizontal';
    private visibility: PlayerVisibility = 'open';
    private maximized = false;
    private viewRequest = 0;
    private panel!: HTMLElement;
    private rail!: HTMLElement;
    private railStatus!: HTMLElement;
    private reopen!: HTMLButtonElement;
    private presentationControl!: HTMLSelectElement;
    private maximizeButton!: HTMLButtonElement;
    private wideLayout = window.matchMedia('(min-width: 1100px)');

    connectedCallback() {
      if (!this.initialized) this.initialize();
      this.pageEvents?.abort();
      this.pageEvents = new AbortController();
      const { signal } = this.pageEvents;
      document.addEventListener('gwenlium:play', ((event: CustomEvent<{ id: string }>) => {
        const index = this.tracks.findIndex((track) => track.id === event.detail?.id);
        if (index >= 0) void this.playTrack(index);
      }) as EventListener, { signal });
      document.addEventListener('gwenlium:window-command', ((event: CustomEvent<WindowCommand>) => {
        this.handleWindowCommand(event.detail || {});
      }) as EventListener, { signal });
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (event.target.closest('[data-open-player]')) {
          this.sendWindowCommand('restore');
          return;
        }
        const button = event.target.closest<HTMLButtonElement>('[data-play-track]');
        if (!button?.dataset.playTrack || button.disabled) return;
        if (this.visibility !== 'open') this.sendWindowCommand('restore');
        if (button.dataset.playTrack === this.tracks[this.index]?.id && !this.audio.paused) this.pause();
        else document.dispatchEvent(new CustomEvent('gwenlium:play', { detail: { id: button.dataset.playTrack } }));
      }, { signal });
      document.addEventListener('keydown', (event) => {
        if (event.defaultPrevented || event.key !== 'Escape' || this.visibility !== 'open' || document.querySelector('dialog[open]')) return;
        if (!this.queue.hidden) {
          event.preventDefault();
          this.setQueueOpen(false, true);
        } else if (this.maximized) {
          event.preventDefault();
          this.sendWindowCommand('restore');
        }
      }, { signal });
      document.addEventListener('astro:before-swap', () => {
        this.viewRequest++;
        cancelWindowAnimation(this.panel);
        this.applyView();
        this.saveView();
      }, { signal });
      document.addEventListener('astro:page-load', () => {
        this.applyView();
        this.updateTrackButtons();
        this.observePanel();
      }, { signal });
      document.addEventListener('gwenlium:chrome-change', () => this.scheduleGeometry(), { signal });
      window.addEventListener('resize', () => this.scheduleGeometry(), { signal });
      this.applyView();
      this.updateTrackButtons();
      this.observePanel();
    }

    disconnectedCallback() {
      this.pageEvents?.abort();
      this.panelObserver?.disconnect();
      cancelAnimationFrame(this.measureFrame);
      this.viewRequest++;
      cancelWindowAnimation(this.panel);
      // ClientRouter moves this persisted element; never reset or pause its audio here.
    }

    private initialize() {
      this.initialized = true;
      this.tracks = JSON.parse(this.dataset.tracks || '[]') as PlayerTrack[];
      this.audio = this.querySelector('[data-player-audio]')!;
      this.toggle = this.querySelector('[data-player-toggle]')!;
      this.seek = this.querySelector('[data-player-seek]')!;
      this.volumes = this.querySelectorAll('[data-player-volume]');
      this.status = this.querySelector('[data-player-status]')!;
      this.titleText = this.querySelector('[data-player-title]')!;
      this.cover = this.querySelector('[data-player-cover]')!;
      this.coverFallback = this.querySelector('[data-player-cover-fallback]')!;
      this.time = this.querySelector('[data-player-time]')!;
      this.queue = this.querySelector('[data-player-queue]')!;
      this.queueToggle = this.querySelector('[data-player-queue-toggle]')!;
      this.panel = this.querySelector('#music-player')!;
      this.rail = this.querySelector('[data-player-rail]')!;
      this.railStatus = this.querySelector('[data-player-rail-status]')!;
      this.reopen = this.querySelector('[data-player-reopen]')!;
      this.presentationControl = this.querySelector('[data-player-presentation]')!;
      this.maximizeButton = this.querySelector('[data-player-maximize]')!;
      try {
        const presentation = localStorage.getItem('gwenlium:player:presentation');
        if (presentation === 'horizontal' || presentation === 'vertical' || presentation === 'left') this.presentation = presentation;
        const visibility = localStorage.getItem('gwenlium:player:visibility');
        if (visibility === 'open' || visibility === 'collapsed' || visibility === 'closed') this.visibility = visibility;
      } catch { /* The player remains usable when storage is unavailable. */ }
      this.presentationControl.addEventListener('change', () => {
        const value = this.presentationControl.value;
        if (value !== 'horizontal' && value !== 'vertical' && value !== 'left') return;
        this.viewRequest++;
        cancelWindowAnimation(this.panel);
        this.presentation = value;
        this.maximized = false;
        this.applyView();
        this.saveView();
      });
      this.reopen.addEventListener('click', () => this.sendWindowCommand('restore'));
      this.querySelector('[data-player-minimize]')!.addEventListener('click', () => this.sendWindowCommand('minimize'));
      this.querySelector('[data-player-close]')!.addEventListener('click', () => this.sendWindowCommand('close'));
      this.maximizeButton.addEventListener('click', () => this.sendWindowCommand(this.maximized ? 'restore' : 'maximize'));
      this.audio.volume = Number(this.volumes[0].value);
      const autoplay = this.querySelector<HTMLInputElement>('[data-player-autoplay]')!;
      try { this.autoplayNext = localStorage.getItem('gwenlium:autoplay-next') === 'true'; } catch { /* Off by default when storage is unavailable. */ }
      autoplay.checked = this.autoplayNext;
      autoplay.addEventListener('change', () => {
        this.autoplayNext = autoplay.checked;
        const status = this.querySelector<HTMLElement>('[data-autoplay-status]')!;
        try {
          localStorage.setItem('gwenlium:autoplay-next', String(this.autoplayNext));
          status.textContent = 'Saved on this device.';
        } catch { status.textContent = 'Applies to this visit; browser storage is unavailable.'; }
      });

      this.queueToggle.addEventListener('click', () => this.setQueueOpen(this.queue.hidden, true));
      this.querySelector('[data-player-queue-close]')!.addEventListener('click', () => this.setQueueOpen(false, true));
      this.toggle.addEventListener('click', () => {
        // The global P shortcut invokes this same button even when the panel is hidden.
        if (this.visibility !== 'open') this.sendWindowCommand('restore');
        if (this.audio.paused) void this.playTrack(this.index);
        else this.pause();
      });
      this.querySelector('[data-player-previous]')!.addEventListener('click', () => {
        if (!this.tracks.length) return;
        if (this.audio.currentTime > 3) { this.audio.currentTime = 0; this.updateProgress(); return; }
        this.changeTrack((this.index - 1 + this.tracks.length) % this.tracks.length);
      });
      this.querySelector('[data-player-next]')!.addEventListener('click', () => {
        if (this.tracks.length) this.changeTrack((this.index + 1) % this.tracks.length);
      });
      this.seek.addEventListener('input', () => {
        if (Number.isFinite(this.audio.duration)) {
          this.audio.currentTime = Number(this.seek.value);
          this.updateProgress();
        }
      });
      this.volumes.forEach((volume) => volume.addEventListener('input', () => {
        this.audio.volume = Number(volume.value);
        this.audio.muted = false;
        this.updateVolume();
      }));
      this.audio.addEventListener('volumechange', () => this.updateVolume());
      this.audio.addEventListener('playing', () => {
        if (!this.userInitiated) { this.audio.pause(); return; }
        this.actuallyPlaying = true;
        this.feedback('Playing');
        this.updateControls();
      });
      this.audio.addEventListener('play', () => this.updateControls());
      this.audio.addEventListener('pause', () => {
        if (!this.audio.paused) return;
        this.actuallyPlaying = false;
        if (!this.audio.error && !this.audio.ended) this.feedback('Paused');
        this.updateControls();
      });
      this.audio.addEventListener('waiting', () => {
        if (this.audio.paused || !this.userInitiated) return;
        this.actuallyPlaying = false;
        this.feedback('Buffering…');
        this.updateControls();
      });
      this.audio.addEventListener('error', () => {
        this.request++;
        this.userInitiated = false;
        this.actuallyPlaying = false;
        this.audio.pause();
        this.feedback('Unable to load this track. Try again or choose another.', true);
        this.updateControls();
      });
      this.audio.addEventListener('ended', () => {
        this.actuallyPlaying = false;
        if (this.userInitiated && this.autoplayNext && this.index < this.tracks.length - 1) void this.playTrack(this.index + 1);
        else {
          this.userInitiated = false;
          this.feedback('Playback finished');
          this.updateControls();
        }
      });
      this.audio.addEventListener('timeupdate', () => this.updateProgress());
      this.audio.addEventListener('durationchange', () => this.updateProgress());
      this.audio.addEventListener('loadedmetadata', () => this.updateProgress());
      this.audio.addEventListener('emptied', () => this.updateProgress());
      this.updateControls();
      this.updateVolume();
    }

    private sendWindowCommand(action: WindowCommand['action']) {
      document.dispatchEvent(new CustomEvent('gwenlium:window-command', { detail: { id: 'music-player', action } }));
    }

    private handleWindowCommand({ id, action }: WindowCommand) {
      if (action === 'restore-all') {
        this.maximized = false;
        void this.setVisibility('open', false);
        return;
      }
      if (id !== 'music-player') {
        if (id && (action === 'maximize' || action === 'restore') && this.maximized) {
          this.viewRequest++;
          cancelWindowAnimation(this.panel);
          this.maximized = false;
          this.applyView();
        }
        return;
      }
      if (action === 'maximize' || action === 'restore') {
        const changedSize = this.maximized !== (action === 'maximize');
        this.maximized = action === 'maximize';
        void this.setVisibility('open', true, changedSize);
      } else if (action === 'minimize' || action === 'close') {
        void this.setVisibility(action === 'close' ? 'closed' : 'collapsed');
      }
    }

    private async setVisibility(visibility: PlayerVisibility, focus = true, changedSize = false) {
      const previous = this.dataset.playerState as PlayerVisibility;
      const request = ++this.viewRequest;
      this.visibility = visibility;
      const anchor = document.querySelector<HTMLElement>('[data-open-player]') || this.reopen;
      if (visibility === 'open') {
        const wasHidden = this.panel.hidden;
        this.applyView();
        this.saveView();
        this.dataset.playerAnimating = 'true';
        const completed = wasHidden || changedSize || previous !== 'open'
          ? await animateWindow(this.panel, previous === 'closed' ? 'open' : 'restore', anchor)
          : (cancelWindowAnimation(this.panel), true);
        if (request !== this.viewRequest || !this.isConnected) return;
        delete this.dataset.playerAnimating;
        if (completed && focus) {
          (changedSize ? this.maximizeButton : this.toggle.disabled ? this.presentationControl : this.toggle).focus({ preventScroll: true });
        }
        return;
      }
      this.dataset.playerAnimating = 'true';
      const completed = this.panel.hidden || await animateWindow(this.panel, visibility === 'closed' ? 'close' : 'minimize', anchor);
      if (request !== this.viewRequest || !this.isConnected) return;
      delete this.dataset.playerAnimating;
      if (!completed) {
        // A cancelled close never commits a hidden state.
        this.visibility = previous;
        return;
      }
      this.maximized = false;
      this.applyView();
      this.saveView();
      if (focus) (visibility === 'collapsed' ? this.reopen : anchor).focus({ preventScroll: true });
    }

    private applyView() {
      delete this.dataset.playerAnimating;
      if (this.visibility !== 'open') this.maximized = false;
      this.dataset.presentation = this.presentation;
      this.dataset.playerState = this.visibility;
      this.dataset.playerMaximized = String(this.maximized && this.visibility === 'open');
      this.panel.hidden = this.visibility !== 'open';
      this.panel.dataset.windowState = this.visibility === 'closed' ? 'closed' : this.visibility === 'collapsed' ? 'minimized' : this.maximized ? 'maximized' : 'normal';
      this.rail.hidden = this.visibility !== 'collapsed';
      this.presentationControl.value = this.presentation;
      const label = this.maximized ? 'Restore Music' : 'Maximize Music';
      this.maximizeButton.setAttribute('aria-label', label);
      this.maximizeButton.title = label;
      this.maximizeButton.setAttribute('aria-pressed', String(this.maximized));
      this.querySelector('[data-player-maximize-icon]')!.setAttribute('d', this.maximized ? 'M5 5V2h9v9h-3M2 5h9v9H2zM2 7.5h9' : 'M3 3h10v10H3zM3 5.5h10');
      this.scheduleGeometry();
      this.publishState(true);
    }

    private saveView() {
      try {
        localStorage.setItem('gwenlium:player:presentation', this.presentation);
        localStorage.setItem('gwenlium:player:visibility', this.visibility);
      } catch { /* Presentation still applies for this visit. */ }
    }

    private publishState(windowsChanged = false) {
      document.dispatchEvent(new CustomEvent('gwenlium:player-state', { detail: {
        presentation: this.dataset.presentation, state: this.dataset.playerState, maximized: this.dataset.playerMaximized === 'true', playing: this.actuallyPlaying,
      } }));
      if (windowsChanged) document.dispatchEvent(new CustomEvent('gwenlium:windows-changed'));
    }

    private observePanel() {
      this.panelObserver?.disconnect();
      this.panelObserver = new ResizeObserver(() => this.scheduleGeometry());
      this.panelObserver.observe(this.panel);
      this.panelObserver.observe(this.rail);
      this.scheduleGeometry();
    }

    private scheduleGeometry() {
      cancelAnimationFrame(this.measureFrame);
      this.measureFrame = requestAnimationFrame(() => {
        if (!this.isConnected) return;
        const floating = this.presentation !== 'horizontal' && this.dataset.playerState !== 'closed' && this.dataset.playerMaximized !== 'true';
        const visible = this.panel.hidden ? this.rail : this.panel;
        const space = this.wideLayout.matches && floating ? `calc(${visible.offsetWidth}px + var(--app-inset, 16px))` : '0px';
        const rootStyle = document.documentElement.style;
        const left = this.presentation === 'left' ? space : '0px';
        const right = this.presentation === 'vertical' ? space : '0px';
        if (rootStyle.getPropertyValue('--player-left-space') === left && rootStyle.getPropertyValue('--player-right-space') === right) return;
        rootStyle.setProperty('--player-left-space', left);
        rootStyle.setProperty('--player-right-space', right);
        this.publishState();
      });
    }

    private updateRail() {
      this.dataset.playing = String(this.actuallyPlaying);
      this.railStatus.textContent = this.actuallyPlaying ? 'Playing' : this.status.classList.contains('player-status--error') ? 'Playback error' : this.status.textContent;
      const title = this.tracks[this.index]?.title;
      this.reopen.setAttribute('aria-label', title ? `Open Music — ${title}` : 'Open Music');
    }

    private setQueueOpen(open: boolean, focus = false) {
      this.queue.hidden = !open;
      this.queueToggle.setAttribute('aria-expanded', String(open));
      this.queueToggle.setAttribute('aria-label', open ? 'Close queue' : 'Open queue');
      if (!focus) return;
      if (open) {
        const target = this.queue.querySelector<HTMLButtonElement>('[data-play-track][aria-current="true"]')
          || this.queue.querySelector<HTMLButtonElement>('[data-play-track]:not(:disabled)')
          || this.queue.querySelector<HTMLButtonElement>('[data-player-queue-close]');
        target?.focus({ preventScroll: true });
