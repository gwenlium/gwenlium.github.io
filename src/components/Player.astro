---
import { tracks } from '../lib/settings';
import manifest from '../generated/media.json';
import Icon from './Icon.astro';
import { getWindowDefinition } from '../lib/windows';

interface ImageVariant { src: string; width: number }
interface ImageRecord { sources: { avif: ImageVariant[]; webp: ImageVariant[] } }
const images = manifest as Record<string, ImageRecord>;
const coverSource = (src: string, minimumWidth: number) => {
  let sourceKey = src;
  try { sourceKey = decodeURIComponent(new URL(src, Astro.site || 'https://gwenlium.dev').pathname); }
  catch { /* Keep malformed escape sequences as authored. */ }
  const image = images[src] || (src.startsWith('/media/') ? images[sourceKey] : undefined);
  const variants = image?.sources.webp.length ? image.sources.webp : image?.sources.avif;
  if (!variants?.length) return src;
  const suitable = variants.filter((variant) => variant.width >= minimumWidth);
  return suitable.length
    ? suitable.reduce((smallest, variant) => variant.width < smallest.width ? variant : smallest).src
    : variants.reduce((largest, variant) => variant.width > largest.width ? variant : largest).src;
};
const queueTracks = tracks.map((track) => ({ ...track, cover: coverSource(track.cover, 112) }));
const playerTracks = tracks.map((track) => ({ ...track, cover: coverSource(track.cover, 896) }));
const availableTracks = playerTracks.filter((track) => track.src);
const firstTrack = availableTracks[0];
const emptyMessage = tracks.length ? 'No playable tracks' : 'No tracks published';
const definition = getWindowDefinition('music-player')!;
---

<gwenlium-player transition:persist="site-player" data-tracks={JSON.stringify(playerTracks)} data-current-track={firstTrack?.id || ''} data-player-state={definition.initiallyClosed ? 'closed' : 'open'} data-player-maximized="false" data-playing="false">
  <audio preload="none" aria-label="Music player" data-player-audio></audio>
  <section id="music-player" class="player-window" aria-labelledby="music-window-title" tabindex="-1" data-desktop-window data-persistent-window data-window-id="music-player" data-window-title={definition.title} data-window-state={definition.initiallyClosed ? 'closed' : 'normal'} hidden={definition.initiallyClosed} style={{ '--player-tone': `var(--${definition.tone})`, width: definition.width > 0 ? `min(${definition.width}px, calc(100vw - 2 * var(--app-inset, 16px)))` : undefined, height: definition.height > 0 ? `min(${definition.height}px, var(--player-workspace-height))` : undefined }}>
    <header class="player-titlebar">
      <span id="music-window-title" class="player-window-title"><Icon name="music" size={14} />{definition.title}</span>
      <div class="player-window-controls" role="group" aria-label={`${definition.title} window controls`}>
        <button type="button" class="player-button player-window-control" data-player-minimize aria-label={`Minimize ${definition.title}`} title={`Minimize ${definition.title}`}><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12h10" /></svg></button>
        <button type="button" class="player-button player-window-control" data-player-maximize aria-label={`Maximize ${definition.title}`} title={`Maximize ${definition.title}`} aria-pressed="false"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path data-player-maximize-icon d="M3 3h10v10H3zM3 5.5h10" /></svg></button>
        <button type="button" class="player-button player-window-control player-window-close" data-player-close aria-label={`Close ${definition.title}`} title={`Close ${definition.title}`}><Icon name="close" size={14} /></button>
      </div>
    </header>
    <div class="player-body">
      <div class="player-content">
        <div class="player-track">
      <div class="player-artwork">
      <div class="player-cover">
        <img data-player-cover src={firstTrack?.cover || undefined} alt={firstTrack?.coverAlt || ''} width="448" height="448" decoding="async" hidden={!firstTrack?.cover} />
        <span data-player-cover-fallback role="img" aria-label={firstTrack ? 'No cover artwork' : 'No track selected'} hidden={Boolean(firstTrack?.cover)}><Icon name="music" size={48} /></span>
      </div>
      </div>
      <div class="player-meta">
        <span class="player-caption">Current track</span>
        <span class="player-title" data-player-title title={firstTrack?.title}>{firstTrack?.title || 'No playable tracks'}</span>
        <span data-player-status class="player-status" role="status" aria-live="polite">{firstTrack ? 'Not playing' : emptyMessage}</span>
      </div>
    </div>
    <div class="player-actions" role="group" aria-label="Track actions">
      <button type="button" class="player-button" data-track-reaction="like" aria-label="Like track" title="Like track" aria-pressed="false" disabled={!firstTrack}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 21H3V10h5m0 11h10l3-11h-7l1-5-3-3-4 8v11Z" /></svg></button>
      <button type="button" class="player-button" data-track-reaction="dislike" aria-label="Dislike track" title="Dislike track" aria-pressed="false" disabled={!firstTrack}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3H3v11h5M8 3h10l3 11h-7l1 5-3 3-4-8V3Z" /></svg></button>
      <button type="button" class="player-button" data-share-track aria-label="Share track" title="Share track" disabled={!firstTrack}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m8 12 9-6m-9 6 9 6" /><path d="M3 9h5v6H3zM17 3h4v5h-4zM17 16h4v5h-4z" /></svg></button>
      <button type="button" class="player-button" data-add-current-track aria-label="Add track to playlist" title="Add track to playlist" disabled={!firstTrack}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 5h18M3 10h18M3 15h8M3 20h8m6-7v9m-4-4h9" /></svg></button>
      <p class="player-action-status" data-music-feedback role="status" aria-live="polite"></p>
    </div>
    <div class="player-seek">
      <label for="player-progress" class="sr-only">Track position</label>
      <span class="player-time" data-player-elapsed aria-hidden="true" title="Elapsed time">0:00</span>
      <input id="player-progress" data-player-seek type="range" min="0" max="0" step="0.1" value="0" disabled />
      <span class="player-time" data-player-remaining aria-hidden="true" title="Time remaining">−0:00</span>
    </div>
    <div class="player-transport" role="group" aria-label="Playback controls">
      <button type="button" class="player-button player-skip" data-player-previous aria-label="Previous track" disabled={availableTracks.length < 2}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4v16M19 4 7 12l12 8Z" /></svg>
      </button>
      <button type="button" data-player-toggle aria-label={firstTrack ? `Play ${firstTrack.title}` : 'Play music'} class="player-button player-toggle" disabled={!firstTrack}>
        <span data-player-play><Icon name="play" size={20} /></span>
        <span data-player-pause hidden><Icon name="pause" size={20} /></span>
      </button>
      <button type="button" class="player-button player-skip" data-player-next aria-label="Next track" disabled={availableTracks.length < 2}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 4v16M5 4l12 8-12 8Z" /></svg>
      </button>
    </div>
    <div class="player-tools">
      <div class="player-volume">
        <label for="player-volume">Vol</label>
        <input id="player-volume" data-player-volume type="range" min="0" max="1" step="0.05" value="0.65" aria-label="Music volume" />
      </div>
      <button type="button" class="player-button player-queue-toggle" data-player-queue-toggle aria-label="Open queue" aria-controls="player-queue" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 5h18M3 10h18M3 15h9M3 20h9m5-6 5 3-5 3Z" /></svg>
        <span class="player-queue-label">Queue</span>
      </button>
    </div>
  </div>
  <section id="player-queue" class="player-queue" data-player-queue aria-labelledby="player-queue-title" hidden>
    <header class="player-queue-header">
      <div><h2 id="player-queue-title">Queue</h2><span>{tracks.length} {tracks.length === 1 ? 'track' : 'tracks'}</span></div>
      <button type="button" class="player-button player-queue-close" data-player-queue-close aria-label="Close queue"><Icon name="close" size={16} /></button>
    </header>
    {queueTracks.length ? (
      <ol class="player-queue-list">
        {queueTracks.map((track, index) => (
          <li>
            <button type="button" class="player-queue-track" data-play-track={track.id} aria-label={`Play ${track.title}`} aria-pressed="false" disabled={!track.src}>
              <span class="player-queue-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="player-queue-cover" data-player-fallback-track={track.cover ? undefined : track.id} aria-hidden="true">
                {track.cover && <img src={track.cover} alt="" width="42" height="42" loading="lazy" decoding="async" />}
              </span>
              <span class="player-queue-meta"><span class="player-queue-title">{track.title}</span><span class="player-track-state" data-track-state>{track.src ? 'Ready' : 'Audio unavailable'}</span></span>
              {track.src && <span class="player-queue-action" data-track-button-label>Play</span>}
            </button>
          </li>
        ))}
      </ol>
    ) : <p class="player-queue-empty">No tracks published yet.</p>}
    <div class="player-queue-footer">
      <label class="player-autoplay"><input type="checkbox" data-player-autoplay />Autoplay next track</label>
      <span class="player-autoplay-status" data-autoplay-status role="status"></span>
      <div class="player-volume">
        <label for="player-queue-volume">Volume</label>
        <input id="player-queue-volume" data-player-volume type="range" min="0" max="1" step="0.05" value="0.65" aria-label="Music volume" />
        <output data-player-volume-value for="player-queue-volume">65%</output>
      </div>
    </div>
  </section>
    </div>
  </section>
</gwenlium-player>

<script>
  import { animateWindow, cancelWindowAnimation } from '../scripts/window-motion';
  import { registerWindow, resetWindowLayout, setWindowMaximized } from '../scripts/window-layout';
  import '../scripts/music-library';

  type PlayerVisibility = 'open' | 'collapsed' | 'closed';
  type WindowCommand = { id?: string; action?: 'restore' | 'maximize' | 'minimize' | 'close' | 'restore-all' };
  interface PlayerTrack { id: string; title: string; src: string; cover: string; coverAlt: string }

  class GwenliumPlayer extends HTMLElement {
    private initialized = false;
    private tracks: PlayerTrack[] = [];
    private libraryOrder: readonly number[] = [];
    private playbackOrder: readonly number[] = [];
    private index = 0;
    private request = 0;
    private userInitiated = false;
    private autoplayNext = false;
    private actuallyPlaying = false;
    private audio!: HTMLAudioElement;
    private toggle!: HTMLButtonElement;
    private previousButton!: HTMLButtonElement;
    private nextButton!: HTMLButtonElement;
    private seek!: HTMLInputElement;
    private volumes!: NodeListOf<HTMLInputElement>;
    private status!: HTMLElement;
    private titleText!: HTMLElement;
    private cover!: HTMLImageElement;
    private coverFallback!: HTMLElement;
    private coverColors = new Map<string | undefined, string>();
    private elapsed!: HTMLElement;
    private remaining!: HTMLElement;
    private queue!: HTMLElement;
    private queueToggle!: HTMLButtonElement;
    private pageEvents?: AbortController;
    private visibility: PlayerVisibility = 'open';
    private maximized = false;
    private viewRequest = 0;
    private panel!: HTMLElement;
    private maximizeButton!: HTMLButtonElement;

    connectedCallback() {
      if (!this.initialized) this.initialize();
      registerWindow(this.panel, { floating: true });
      this.pageEvents?.abort();
      this.pageEvents = new AbortController();
      const { signal } = this.pageEvents;
      document.addEventListener('gwenlium:play', ((event: CustomEvent<{ id: string }>) => {
        const index = this.tracks.findIndex((track) => track.id === event.detail?.id);
        if (index < 0) return;
        this.setPlaybackOrder(this.libraryOrder);
        void this.playTrack(index);
      }) as EventListener, { signal });
      document.addEventListener('gwenlium:playlist-play', ((event: CustomEvent<{ ids: string[]; startId?: string }>) => {
        if (!Array.isArray(event.detail?.ids)) return;
        const order: number[] = [];
        for (const id of event.detail.ids) {
          const index = this.tracks.findIndex((track) => track.id === id);
          if (index >= 0 && !order.includes(index)) order.push(index);
        }
        if (!order.length) return;
        this.setPlaybackOrder(order);
        const requested = this.tracks.findIndex((track) => track.id === event.detail.startId);
        if (this.visibility !== 'open') this.sendWindowCommand('restore');
        void this.playTrack(order.includes(requested) ? requested : order[0]);
      }) as EventListener, { signal });
      document.addEventListener('gwenlium:window-command', ((event: CustomEvent<WindowCommand>) => {
        this.handleWindowCommand(event.detail || {});
      }) as EventListener, { signal });
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (event.target.closest('[data-open-player]')) {
          this.sendWindowCommand('restore');
          return;
        }
        const button = event.target.closest<HTMLButtonElement>('[data-play-track]');
        if (!button?.dataset.playTrack || button.disabled) return;
        if (this.visibility !== 'open') this.sendWindowCommand('restore');
        if (button.dataset.playTrack === this.tracks[this.index]?.id && !this.audio.paused) this.pause();
        else document.dispatchEvent(new CustomEvent('gwenlium:play', { detail: { id: button.dataset.playTrack } }));
      }, { signal });
      document.addEventListener('keydown', (event) => {
        if (event.defaultPrevented || event.key !== 'Escape' || this.visibility !== 'open' || document.querySelector('dialog[open]')) return;
        if (!this.queue.hidden) {
          event.preventDefault();
          this.setQueueOpen(false, true);
        } else if (this.maximized) {
          event.preventDefault();
          this.sendWindowCommand('restore');
        }
      }, { signal });
      document.addEventListener('astro:before-swap', () => {
        this.viewRequest++;
        cancelWindowAnimation(this.panel);
        this.applyView();
        this.saveView();
      }, { signal });
      document.addEventListener('astro:page-load', () => {
        registerWindow(this.panel, { floating: true });
        this.applyView();
        this.updateTrackButtons();
      }, { signal });
      this.applyView();
      this.updateTrackButtons();
    }

    disconnectedCallback() {
      this.pageEvents?.abort();
      this.viewRequest++;
      cancelWindowAnimation(this.panel);
      // ClientRouter moves this persisted element; never reset or pause its audio here.
    }

    private initialize() {
      this.initialized = true;
      this.tracks = (JSON.parse(this.dataset.tracks || '[]') as PlayerTrack[]).filter((track) => track.src);
      this.libraryOrder = this.tracks.map((_, index) => index);
      this.audio = this.querySelector('[data-player-audio]')!;
      this.toggle = this.querySelector('[data-player-toggle]')!;
      this.previousButton = this.querySelector('[data-player-previous]')!;
      this.nextButton = this.querySelector('[data-player-next]')!;
      this.setPlaybackOrder(this.libraryOrder);
      this.seek = this.querySelector('[data-player-seek]')!;
      this.volumes = this.querySelectorAll('[data-player-volume]');
      this.status = this.querySelector('[data-player-status]')!;
      this.titleText = this.querySelector('[data-player-title]')!;
      this.cover = this.querySelector('[data-player-cover]')!;
      this.coverFallback = this.querySelector('[data-player-cover-fallback]')!;
      this.cover.addEventListener('error', () => {
        this.cover.hidden = true;
        this.coverFallback.hidden = false;
        this.coverFallback.setAttribute('aria-label', 'Artwork unavailable');
      });
      this.querySelectorAll<HTMLElement>('[data-player-fallback-track]').forEach((cover) => {
        cover.style.backgroundColor = this.coverColor(cover.dataset.playerFallbackTrack);
      });
      this.updateCover(this.tracks[this.index]);
      this.elapsed = this.querySelector('[data-player-elapsed]')!;
      this.remaining = this.querySelector('[data-player-remaining]')!;
      this.queue = this.querySelector('[data-player-queue]')!;
      this.queueToggle = this.querySelector('[data-player-queue-toggle]')!;
      this.panel = this.querySelector('#music-player')!;
      this.maximizeButton = this.querySelector('[data-player-maximize]')!;
      this.visibility = this.dataset.playerState === 'closed' ? 'closed' : 'open';
      try {
        const visibility = localStorage.getItem('gwenlium:player:visibility');
        if (visibility === 'open' || visibility === 'collapsed' || visibility === 'closed') this.visibility = visibility;
      } catch { /* The player remains usable when storage is unavailable. */ }
      this.querySelector('[data-player-minimize]')!.addEventListener('click', () => this.sendWindowCommand('minimize'));
      this.querySelector('[data-player-close]')!.addEventListener('click', () => this.sendWindowCommand('close'));
      this.maximizeButton.addEventListener('click', () => this.sendWindowCommand(this.maximized ? 'restore' : 'maximize'));
      this.audio.volume = Number(this.volumes[0].value);
      const autoplay = this.querySelector<HTMLInputElement>('[data-player-autoplay]')!;
      try { this.autoplayNext = localStorage.getItem('gwenlium:autoplay-next') === 'true'; } catch { /* Off by default when storage is unavailable. */ }
      autoplay.checked = this.autoplayNext;
      autoplay.addEventListener('change', () => {
        this.autoplayNext = autoplay.checked;
        const status = this.querySelector<HTMLElement>('[data-autoplay-status]')!;
        try {
          localStorage.setItem('gwenlium:autoplay-next', String(this.autoplayNext));
          status.textContent = 'Saved on this device.';
        } catch { status.textContent = 'Applies to this visit; browser storage is unavailable.'; }
      });

      this.queueToggle.addEventListener('click', () => this.setQueueOpen(this.queue.hidden, true));
      this.querySelector('[data-player-queue-close]')!.addEventListener('click', () => this.setQueueOpen(false, true));
      this.toggle.addEventListener('click', () => {
        // The global P shortcut invokes this same button even when the panel is hidden.
        if (this.visibility !== 'open') this.sendWindowCommand('restore');
        if (this.audio.paused) void this.playTrack(this.index);
        else this.pause();
      });
      this.previousButton.addEventListener('click', () => {
        if (!this.tracks.length) return;
        if (this.audio.currentTime > 3) { this.audio.currentTime = 0; this.updateProgress(); return; }
        this.changeTrack(-1);
      });
      this.nextButton.addEventListener('click', () => this.changeTrack(1));
      this.seek.addEventListener('input', () => {
        if (Number.isFinite(this.audio.duration)) {
          this.audio.currentTime = Number(this.seek.value);
          this.updateProgress();
        }
      });
      this.volumes.forEach((volume) => volume.addEventListener('input', () => {
        this.audio.volume = Number(volume.value);
        this.audio.muted = false;
        this.updateVolume();
      }));
      this.audio.addEventListener('volumechange', () => this.updateVolume());
      this.audio.addEventListener('playing', () => {
        if (!this.userInitiated) { this.audio.pause(); return; }
        this.actuallyPlaying = true;
        this.feedback('Playing');
        this.updateControls();
      });
      this.audio.addEventListener('play', () => this.updateControls());
      this.audio.addEventListener('pause', () => {
        if (!this.audio.paused) return;
        this.actuallyPlaying = false;
        if (!this.audio.error && !this.audio.ended) this.feedback('Paused');
        this.updateControls();
      });
      this.audio.addEventListener('waiting', () => {
        if (this.audio.paused || !this.userInitiated) return;
        this.actuallyPlaying = false;
        this.feedback('Buffering…');
        this.updateControls();
      });
      this.audio.addEventListener('error', () => {
        this.request++;
        this.userInitiated = false;
        this.actuallyPlaying = false;
        this.audio.pause();
        this.feedback('Unable to load this track. Try again or choose another.', true);
        this.updateControls();
      });
      this.audio.addEventListener('ended', () => {
        this.actuallyPlaying = false;
        const position = this.playbackOrder.indexOf(this.index);
        if (this.userInitiated && this.autoplayNext && position >= 0 && position < this.playbackOrder.length - 1) void this.playTrack(this.playbackOrder[position + 1]);
        else {
          this.userInitiated = false;
          this.feedback('Playback finished');
          this.updateControls();
        }
      });
      this.audio.addEventListener('timeupdate', () => this.updateProgress());
      this.audio.addEventListener('durationchange', () => this.updateProgress());
      this.audio.addEventListener('loadedmetadata', () => this.updateProgress());
      this.audio.addEventListener('emptied', () => this.updateProgress());
      this.updateControls();
      this.updateVolume();
      this.publishCurrentTrack();
    }

    private sendWindowCommand(action: WindowCommand['action']) {
      document.dispatchEvent(new CustomEvent('gwenlium:window-command', { detail: { id: 'music-player', action } }));
    }

    private handleWindowCommand({ id, action }: WindowCommand) {
      if (action === 'restore-all') {
        this.viewRequest++;
        cancelWindowAnimation(this.panel);
        this.maximized = false;
        this.visibility = 'open';
        this.applyView();
        resetWindowLayout(this.panel);
        this.saveView();
        return;
      }
      if (id !== 'music-player') {
        if (id && (action === 'maximize' || action === 'restore') && this.maximized) {
          this.viewRequest++;
          cancelWindowAnimation(this.panel);
          this.maximized = false;
          this.applyView();
        }
        return;
      }
      if (action === 'maximize' || action === 'restore') {
        const changedSize = this.maximized !== (action === 'maximize');
        this.maximized = action === 'maximize';
        void this.setVisibility('open', true, changedSize);
      } else if (action === 'minimize' || action === 'close') {
        void this.setVisibility(action === 'close' ? 'closed' : 'collapsed');
      }
    }

    private async setVisibility(visibility: PlayerVisibility, focus = true, changedSize = false) {
      const previous = this.dataset.playerState as PlayerVisibility;
      const request = ++this.viewRequest;
      this.visibility = visibility;
      const anchor = document.querySelector<HTMLElement>('.taskbar [data-open-player]') || undefined;
      if (visibility === 'open') {
        const wasHidden = this.panel.hidden;
        this.applyView();
        this.saveView();
        const completed = wasHidden || changedSize || previous !== 'open'
          ? await animateWindow(this.panel, previous === 'closed' ? 'open' : 'restore', anchor)
          : (cancelWindowAnimation(this.panel), true);
        if (request !== this.viewRequest || !this.isConnected) return;
        if (completed && focus) {
          (changedSize ? this.maximizeButton : this.toggle.disabled ? this.queueToggle : this.toggle).focus({ preventScroll: true });
        }
        return;
      }
      const completed = this.panel.hidden || await animateWindow(this.panel, visibility === 'closed' ? 'close' : 'minimize', anchor);
      if (request !== this.viewRequest || !this.isConnected) return;
      if (!completed) {
        // A cancelled close never commits a hidden state.
        this.visibility = previous;
        return;
      }
      this.maximized = false;
      this.applyView();
      this.saveView();
      if (focus) anchor?.focus({ preventScroll: true });
    }

    private applyView() {
      if (this.visibility !== 'open') this.maximized = false;
      this.dataset.playerState = this.visibility;
      this.dataset.playerMaximized = String(this.maximized && this.visibility === 'open');
      this.panel.hidden = this.visibility !== 'open';
      this.panel.dataset.windowState = this.visibility === 'closed' ? 'closed' : this.visibility === 'collapsed' ? 'minimized' : this.maximized ? 'maximized' : 'normal';
      setWindowMaximized(this.panel, this.maximized);
      const label = `${this.maximized ? 'Restore' : 'Maximize'} ${this.panel.dataset.windowTitle}`;
      this.maximizeButton.setAttribute('aria-label', label);
      this.maximizeButton.title = label;
      this.maximizeButton.setAttribute('aria-pressed', String(this.maximized));
      this.querySelector('[data-player-maximize-icon]')!.setAttribute('d', this.maximized ? 'M5 5V2h9v9h-3M2 5h9v9H2zM2 7.5h9' : 'M3 3h10v10H3zM3 5.5h10');
      this.publishState(true);
    }

    private saveView() {
      try {
        localStorage.setItem('gwenlium:player:visibility', this.visibility);
      } catch { /* Visibility still applies for this visit. */ }
    }

    private publishState(windowsChanged = false) {
      document.dispatchEvent(new CustomEvent('gwenlium:player-state', { detail: {
        state: this.dataset.playerState, maximized: this.dataset.playerMaximized === 'true', playing: this.actuallyPlaying,
      } }));
      if (windowsChanged) document.dispatchEvent(new CustomEvent('gwenlium:windows-changed'));
    }


    private setQueueOpen(open: boolean, focus = false) {
      this.queue.hidden = !open;
      this.queueToggle.setAttribute('aria-expanded', String(open));
      this.queueToggle.setAttribute('aria-label', open ? 'Close queue' : 'Open queue');
      if (!focus) return;
      if (open) {
        const target = this.queue.querySelector<HTMLButtonElement>('[data-play-track][aria-current="true"]')
          || this.queue.querySelector<HTMLButtonElement>('[data-play-track]:not(:disabled)')
          || this.queue.querySelector<HTMLButtonElement>('[data-player-queue-close]');
        target?.focus({ preventScroll: true });
        target?.scrollIntoView({ block: 'nearest' });
      } else {
        this.queueToggle.focus({ preventScroll: true });
        this.queueToggle.scrollIntoView({ block: 'nearest' });
      }
    }

    private feedback(message: string, error = false) {
      if (this.status.textContent !== message) this.status.textContent = message;
      this.status.classList.toggle('player-status--error', error);
    }

    private pause() {
      this.request++;
      this.userInitiated = false;
      this.actuallyPlaying = false;
      this.audio.pause();
      this.feedback('Paused');
      this.updateControls();
    }

    private coverColor(id?: string) {
      let color = this.coverColors.get(id);
      if (!color) {
        color = `hsl(${Math.floor(Math.random() * 360)} 45% 72%)`;
        this.coverColors.set(id, color);
      }
      return color;
    }

    private updateCover(track?: PlayerTrack) {
      this.cover.hidden = !track?.cover;
      this.coverFallback.hidden = Boolean(track?.cover);
      this.cover.alt = track?.coverAlt || '';
      this.coverFallback.setAttribute('aria-label', track ? 'No cover artwork' : 'No track selected');
      if (track?.cover) this.cover.src = track.cover;
      else {
        this.cover.removeAttribute('src');
      }
    }

    private setPlaybackOrder(order: readonly number[]) {
      this.playbackOrder = order;
      this.previousButton.disabled = this.nextButton.disabled = order.length < 2;
    }

    private publishCurrentTrack() {
      const id = this.tracks[this.index]?.id || '';
      this.dataset.currentTrack = id;
      document.dispatchEvent(new CustomEvent('gwenlium:track-change', { detail: { id } }));
    }

    private selectTrack(index: number) {
      const track = this.tracks[index];
      if (this.index === index && this.audio.dataset.track === track.id && !this.audio.error) return;
      this.audio.pause();
      this.index = index;
      this.actuallyPlaying = false;
      this.audio.src = track.src;
      this.audio.dataset.track = track.id;
      this.audio.setAttribute('aria-label', track.title);
      this.titleText.textContent = track.title;
      this.titleText.title = track.title;
      this.updateCover(track);
      this.updateProgress();
      this.updateControls();
      this.publishCurrentTrack();
    }

    private changeTrack(direction: -1 | 1) {
      if (!this.playbackOrder.length) return;
      const position = this.playbackOrder.indexOf(this.index);
      const index = this.playbackOrder[(position + direction + this.playbackOrder.length) % this.playbackOrder.length];
      const continuePlaying = !this.audio.paused && this.userInitiated;
      this.request++;
      this.userInitiated = false;
      this.selectTrack(index);
      if (continuePlaying) void this.playTrack(index);
      else this.feedback('Paused');
    }

    private async playTrack(index: number) {
      if (!this.tracks[index]) return;
      this.userInitiated = true;
      if (index === this.index && !this.audio.paused && this.actuallyPlaying) {
        this.feedback('Playing');
        return;
      }
      this.selectTrack(index);
      const request = ++this.request;
      this.feedback('Loading…');
      try {
        await this.audio.play();
      } catch (error) {
        if (request !== this.request) return;
        this.userInitiated = false;
        this.actuallyPlaying = false;
        this.feedback(error instanceof DOMException && error.name === 'NotAllowedError'
          ? 'Playback was blocked. Press play to try again.'
          : 'Unable to play this track. Try again or choose another.', true);
        this.updateControls();
      }
    }

    private updateControls() {
      const track = this.tracks[this.index];
      const active = !this.audio.paused && !this.audio.ended;
      if (track) this.toggle.setAttribute('aria-label', `${active ? 'Pause' : 'Play'} ${track.title}`);
      this.querySelector<HTMLElement>('[data-player-play]')!.hidden = active;
      this.querySelector<HTMLElement>('[data-player-pause]')!.hidden = !active;
      this.updateTrackButtons();
      this.dataset.playing = String(this.actuallyPlaying);
      this.publishState();
    }

    private updateTrackButtons() {
      document.querySelectorAll<HTMLButtonElement>('[data-play-track]').forEach((button) => {
        const track = this.tracks.find((entry) => entry.id === button.dataset.playTrack);
        if (!track) return;
        const selected = track.id === this.tracks[this.index]?.id;
        const active = selected && !this.audio.paused && !this.audio.ended;
        button.setAttribute('aria-pressed', String(active));
        button.setAttribute('aria-label', `${active ? 'Pause' : 'Play'} ${track.title}`);
        if (selected) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
        const label = button.querySelector('[data-track-button-label]');
        if (label) label.textContent = active ? 'Pause' : 'Play';
        const state = button.querySelector('[data-track-state]') || button.closest('[data-track-row]')?.querySelector('[data-track-state]');
        if (state) state.textContent = selected ? (this.actuallyPlaying ? 'Playing' : active ? 'Loading…' : 'Selected') : 'Ready';
      });
    }

    private updateVolume() {
      const value = this.audio.muted ? 0 : this.audio.volume;
      const percent = Math.round(value * 100);
      this.volumes.forEach((volume) => {
        volume.value = String(value);
        volume.setAttribute('aria-valuetext', `${percent} percent`);
      });
      this.querySelector('[data-player-volume-value]')!.textContent = `${percent}%`;
    }

    private updateProgress() {
      const duration = Number.isFinite(this.audio.duration) ? this.audio.duration : 0;
      const position = Number.isFinite(this.audio.currentTime) ? this.audio.currentTime : 0;
      this.seek.disabled = duration <= 0;
      this.seek.max = String(duration);
      this.seek.value = String(position);
      const elapsed = this.formatTime(position);
      const remaining = this.formatTime(Math.ceil(Math.max(0, duration - position)));
      this.elapsed.textContent = elapsed;
      this.remaining.textContent = `−${remaining}`;
      this.seek.setAttribute('aria-valuetext', `${elapsed} elapsed, ${remaining} remaining`);
    }

    private formatTime(seconds: number) {
      const whole = Math.floor(seconds);
      return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, '0')}`;
    }
  }

  if (!customElements.get('gwenlium-player')) customElements.define('gwenlium-player', GwenliumPlayer);
</script>

