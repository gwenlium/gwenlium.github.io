---
import { render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import EntryView from './EntryView.astro';
import { getPosts, postUrl, postSourceFile, postPreview, postPicture, formatDate, type Post } from '../lib/content';
import { hasWindowOverride } from '../lib/windows';

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const related = (await getPosts(post.data.section))
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => ({ candidate, sharedTags: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length }))
  .filter(({ sharedTags }) => sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags)
  .slice(0, 3)
  .map(({ candidate }) => ({ url: postUrl(candidate), title: candidate.data.title, sourceFile: postSourceFile(candidate), date: candidate.data.date, dateLabel: formatDate(candidate.data.date) }));
const shareUrl = new URL(postUrl(post), Astro.site ?? 'https://gwenlium.dev').href;
const sourceFile = postSourceFile(post);
const link = (entry?: Post) => entry && { url: postUrl(entry), title: entry.data.title, sourceFile: postSourceFile(entry) };
const mediaItems = [
  ...(post.data.cover ? [{ src: post.data.cover, type: 'image' as const, alt: post.data.coverAlt, eager: true, editFile: sourceFile, editField: '/cover', editAltField: '/coverAlt', editLabel: 'Post cover' }] : []),
  ...post.data.photos.map((src, index) => ({ src, type: 'image' as const, alt: '', editFile: sourceFile, editField: `/photos/${index}`, editLabel: 'Post photo' })),
  ...post.data.media.map((item, index) => ({ ...item, editFile: sourceFile, editField: `/media/${index}/src`, editAltField: `/media/${index}/alt`, editCaptionField: `/media/${index}/caption` })),
];
const picture = postPicture(post);
const hasEntryMedia = mediaItems.length > 0 || /!\[|<(?:img|video|audio|iframe)\b/i.test(post.rendered?.html ?? post.body ?? '') || hasWindowOverride('post-media');
---

{/* Link previews use the cover, else the first picture; an animation as its still first frame. */}
<SiteLayout title={post.data.title} description={postPreview(post)} image={picture && (picture.still ?? picture.src)} imageAlt={picture?.alt} article>
  <EntryView section={post.data.section} title={post.data.title} date={post.data.date} dateLabel={formatDate(post.data.date)} tags={post.data.tags}
    excerpt={post.data.excerpt} sourceFile={sourceFile} contents={contents} mediaItems={mediaItems} hasEntryMedia={hasEntryMedia}
    shareUrl={shareUrl} older={link(older)} newer={link(newer)} related={related}><Content /></EntryView>
</SiteLayout>
