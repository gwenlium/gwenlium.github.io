---
import DialogueReader from './DialogueReader.astro';
import Window from '../components/Window.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/settings';
import { hasWindowOverride } from '../lib/windows';

const game = site.game;
const links = game.links.filter((link) => link.label && /^(https?:\/\/|mailto:|\/(?!\/))/.test(link.url));
let embed = '';
let trailer = '';
let directVideo = false;
if (game.trailerUrl) {
  try {
    const url = new URL(game.trailerUrl, Astro.site);
    if (url.protocol === 'https:' || url.protocol === 'http:') {
      trailer = url.href;
      directVideo = /\.(mp4|webm|ogg|ogv|mov)$/i.test(url.pathname);
      const youtubeHosts = ['youtube.com', 'www.youtube.com', 'm.youtube.com', 'youtube-nocookie.com', 'www.youtube-nocookie.com'];
      const youtubeId = url.hostname === 'youtu.be'
        ? url.pathname.slice(1)
        : youtubeHosts.includes(url.hostname)
          ? url.searchParams.get('v') || url.pathname.match(/^\/(?:embed|shorts)\/([^/]+)/)?.[1]
          : '';
      if (youtubeId && /^[\w-]{11}$/.test(youtubeId)) embed = `https://www.youtube-nocookie.com/embed/${youtubeId}`;
      if (['vimeo.com', 'www.vimeo.com', 'player.vimeo.com'].includes(url.hostname)) {
        const id = url.pathname.match(/^\/(?:video\/)?(\d+)(?:\/|$)/)?.[1];
        if (id) embed = `https://player.vimeo.com/video/${id}?dnt=1`;
      }
    }
  } catch { /* Invalid trailer addresses are not rendered as active links. */ }
}
---

<div class="game-overview">
  {(game.title || game.status || game.cover || game.description || links.length > 0 || hasWindowOverride('game-details')) && (
    <div class="game-slot">
      <Window windowId="game-details">
        <header class="game-heading">
          <span class="eyebrow">Game development</span>
          <h2>{game.title || 'Game'}</h2>
          {game.status && <p class="game-status"><span aria-hidden="true">◆</span> {game.status}</p>}
        </header>
          {game.cover && <div class="game-cover"><Media src={game.cover} alt={game.coverAlt} eager /></div>}
          {game.description && <DialogueReader id="game-reading"><div class="game-description prose" data-dialogue-blocks>{game.description.split(/\n\s*\n/).map(paragraph => <p>{paragraph}</p>)}</div></DialogueReader>}
          {links.length > 0 && <nav class="game-links" aria-label="Game links">
            {links.map((link) => <a class="button" href={link.url}>{link.label}<Icon name="external" size={14} /></a>)}
          </nav>}
      </Window>
    </div>
  )}
  {(trailer || hasWindowOverride('game-trailer')) && <div class="game-slot">
    <Window windowId="game-trailer">
      {directVideo ? <Media src={game.trailerUrl} type="video" alt={`${game.title || 'Game'} trailer`} poster={game.cover} /> : embed ? (
          <div class="trailer-frame"><iframe src={embed} title={`${game.title || 'Game'} trailer`} loading="lazy" allow="fullscreen; picture-in-picture; encrypted-media" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
        ) : <a class="button" href={trailer}>Watch trailer<Icon name="external" size={14} /></a>}
    </Window>
  </div>}
</div>

<style>
  .game-overview { display: grid; gap: 1.5rem; min-width: 0; }
  .game-overview:not(:has(:global(:is([data-desktop-window], [data-window-placeholder])))), .game-slot:not(:has(:global(:is([data-desktop-window], [data-window-placeholder])))) { display: none; }
  .game-slot { min-width: 0; }
  .game-heading { margin-bottom: 1.25rem; }
  .game-heading h2 { font-size: clamp(1.15rem, 1rem + 1cqi, 1.5rem); line-height: 1.45; margin: 0 0 .8rem; overflow-wrap: anywhere; }
  .game-cover { min-width: 0; margin-bottom: 1.25rem; }
  .game-cover :global(figure) { margin: 0; }
  .game-cover :global(img) { width: 100%; max-height: 320px; object-fit: contain; }
  .game-status { display: inline-flex; align-items: center; gap: .6rem; max-width: 100%; margin: 0; padding: .5rem .7rem; border: 1px solid var(--line); background: var(--sage); color: var(--ink); font-size: .75rem; overflow-wrap: anywhere; }
  .game-status span { font-size: .6rem; }
  .game-description p { white-space: pre-line; margin-top: 0; }
  .game-links { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .trailer-frame { position: relative; aspect-ratio: 16 / 9; background: var(--ink); }
  .trailer-frame iframe { width: 100%; height: 100%; border: 0; }
</style>
