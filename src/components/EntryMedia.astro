---
import Media from './Media.astro';

interface Props {
  id: string;
  sourceId: string;
  items: {
    src: string;
    type?: 'image' | 'video' | 'audio';
    alt?: string;
    caption?: string;
    poster?: string;
    eager?: boolean;
  }[];
}

const { id, sourceId, items } = Astro.props;
const media = items.filter(item => item.src);
const labelFor = (item: Props['items'][number], index: number) =>
  (item.alt || item.caption || `${item.type === 'video' ? 'Video' : item.type === 'audio' ? 'Audio' : 'Image'} ${index + 1}`).replace(/\s+/g, ' ').trim();
---

<section id={id} class="entry-media-viewer" aria-label="Entry media" data-entry-media data-entry-media-source={sourceId}>
  <div id={`${id}-items`} class="entry-media-items" data-entry-media-items>
    {media.map((item, index) => <div id={`${id}-item-${index + 1}`} data-entry-media-item data-entry-media-label={labelFor(item, index)} role="group" aria-label={`${index + 1}: ${labelFor(item, index)}`}>
      <Media {...item} />
    </div>)}
  </div>
  <nav class="entry-media-controls" aria-label="Media navigation" data-entry-media-controls hidden>
    <button class="button button-secondary" type="button" data-entry-media-previous aria-controls={`${id}-items`}>Previous</button>
    <span role="status" aria-live="polite" aria-atomic="true" data-entry-media-status></span>
    <button class="button button-secondary" type="button" data-entry-media-next aria-controls={`${id}-items`}>Next</button>
  </nav>
  <div class="entry-media-selection" role="group" aria-label="Choose media" data-entry-media-selection hidden></div>
  <p class="entry-media-empty" data-entry-media-empty hidden>No media in this entry.</p>
</section>

<style>
  .entry-media-viewer { min-width: 0; }
  .entry-media-items { display: grid; gap: 1.25rem; min-width: 0; }
  .entry-media-viewer :global([data-entry-media-item]) { min-width: 0; overflow-wrap: anywhere; }
  .entry-media-viewer :global([data-entry-media-item] figure) { margin: 0; }
  .entry-media-viewer :global([data-entry-media-item] picture) { display: block; max-width: 100%; }
  .entry-media-viewer :global([data-entry-media-item] img),
  .entry-media-viewer :global([data-entry-media-item] video) { display: block; width: 100%; height: auto; max-height: min(65dvh, max(10rem, calc(var(--window-height, 44rem) - 15rem))); margin: 0 auto; object-fit: contain; }
  .entry-media-viewer :global([data-entry-media-item] audio) { display: block; width: 100%; }
  .entry-media-viewer :global([data-entry-media-item] iframe) { display: block; max-width: 100%; }
  .entry-media-viewer :global([data-entry-media-item] figcaption) { margin-top: .65rem; color: var(--muted); font-family: var(--font-reading); font-size: .88rem; line-height: 1.6; white-space: pre-line; }
  .entry-media-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; margin-top: .8rem; }
  [data-entry-media-status] { font-size: .75rem; white-space: nowrap; }
  .entry-media-selection { display: flex; gap: .4rem; overflow-x: auto; padding: .35rem 0; margin-top: .5rem; scrollbar-width: thin; }
  .entry-media-selection :global(button) { flex-shrink: 0; min-width: 2.5rem; min-height: 36px; padding: .4rem .6rem; font-size: .7rem; }
  .entry-media-selection :global(button[aria-pressed='true']) { border-color: var(--ink); background: var(--sage); }
  .entry-media-empty { margin: 0; color: var(--muted); }
  .entry-media-viewer :global([hidden]) { display: none !important; }
  :global([data-entry-media-ref]), :global([data-entry-media-only]) { display: none !important; }
  @media (max-width: 760px), (pointer: coarse) {
    .entry-media-controls button, .entry-media-selection :global(button) { min-height: 44px; }
  }
  @media print {
    .entry-media-controls, .entry-media-selection { display: none !important; }
    .entry-media-viewer :global([data-entry-media-item][hidden]) { display: block !important; }
    .entry-media-viewer :global([data-entry-media-item]:empty) { display: none !important; }
    .entry-media-viewer :global([data-entry-media-item]) { break-inside: avoid; }
    .entry-media-viewer :global([data-entry-media-item] img),
    .entry-media-viewer :global([data-entry-media-item] video) { max-height: none; }
  }
</style>

<script>
  import '../scripts/entry-media';
</script>
