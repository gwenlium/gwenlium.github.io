---
import Media from './Media.astro';
import Icon from './Icon.astro';
import { formatDate, postUrl, postSourceFile, postPreview, type Post } from '../lib/content';

interface Props { post: Post; compact?: boolean }
const { post, compact = false } = Astro.props;
const { title, date, cover, coverAlt, tags } = post.data;
const sourceFile = postSourceFile(post);
const preview = postPreview(post);
---

<article class:list={['post-card', { 'has-cover': cover, 'post-card--compact': compact }]}>
  {cover && <div class="post-cover">{compact ? <a href={postUrl(post)} aria-label={`Read ${title}`}><Media src={cover} alt={coverAlt} sizes="80px" editFile={sourceFile} editField="/cover" editAltField="/coverAlt" editLabel="Post cover" /></a> : <Media src={cover} alt={coverAlt} editFile={sourceFile} editField="/cover" editAltField="/coverAlt" editLabel="Post cover" />}</div>}
  <div class="post-details">
    <a class="tag" href={`/${post.data.section}/`}>{post.data.section === 'life' ? 'Life' : 'Devlog'}</a>
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    <h2><a href={postUrl(post)} data-site-edit-file={sourceFile} data-site-edit-field="/title" data-site-edit-format="text" data-site-edit-label="Post title">{title}</a></h2>
    {preview && <p class="post-excerpt" data-site-edit-file={sourceFile} data-site-edit-field="/excerpt" data-site-edit-format="text" data-site-edit-label="Post excerpt" data-site-edit-template="post-preview">{preview}</p>}
    {!compact && tags.length > 0 && <ul class="post-tags" aria-label="Tags">{tags.map((tag) => (
      <li><a class="tag" href={`/${post.data.section}/?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
    ))}</ul>}
    <a class="read-post" href={postUrl(post)} aria-label={`Read ${title}`}>Read entry <Icon name="arrow" size={14} /></a>
  </div>
</article>

<style>
  .post-card { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(.75rem, 3cqi, 1.2rem); padding: clamp(1rem, 4cqi, 1.5rem) 0; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  .post-card:first-child { padding-top: 0; }
  .post-card:last-child { padding-bottom: 0; border-bottom: 0; }
  .post-details { min-width: 0; }
  time { color: var(--muted); font-size: .72rem; }
  .post-details > .tag + time { display: block; margin-top: .65rem; }
  h2 { margin: .65rem 0; font-size: clamp(1rem, .8rem + 1.5cqi, 1.35rem); line-height: 1.45; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .post-excerpt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; max-height: 5.4em; overflow: hidden; font-family: var(--font-reading); margin: 0 0 1rem; line-height: 1.8; color: var(--muted); }
  .post-tags { display: flex; flex-wrap: wrap; gap: .4rem; padding: 0; margin: .8rem 0; list-style: none; }
  .post-tags li { min-width: 0; max-width: 100%; }
  .read-post { display: inline-flex; align-items: center; gap: .5rem; margin-top: .5rem; font-size: .75rem; text-underline-offset: .25em; }
  .read-post + .read-post { margin-left: 1rem; }
  .post-cover { min-width: 0; }
  .post-cover :global(figure) { margin: 0; }
  .post-cover :global(img) { width: 100%; max-height: 15rem; object-fit: contain; }
  @container window-content (min-width: 640px) { .has-cover { grid-template-columns: minmax(10rem, 31%) minmax(0, 1fr); } }
  .post-card--compact { gap: .85rem; }
  .post-card--compact.has-cover { grid-template-columns: 80px minmax(0, 1fr); align-items: start; }
  .post-card--compact .post-cover :global(img) { height: 96px; object-fit: contain; }
  .post-card--compact .post-details > .tag, .post-card--compact time { font-size: .65rem; }
  .post-card--compact .post-details > .tag + time { display: inline; margin-left: .5rem; }
  .post-card--compact h2 { font-size: 1rem; }
  .post-card--compact .post-excerpt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; max-height: 4.8em; overflow: hidden; font-size: .8rem; line-height: 1.6; margin-bottom: .5rem; }
  .post-card--compact .read-post { font-size: .7rem; }
</style>
