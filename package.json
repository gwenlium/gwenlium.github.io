    "@ffmpeg/ffmpeg": "0.12.15",
    "astro": "7.3.3",
    "decap-cms-app": "3.16.2",
    "decap-cms-backend-github": "3.8.2",
    "minisearch": "7.2.0",
    "react": "19.3.0",
