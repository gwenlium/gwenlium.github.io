    "@astrojs/check": "0.9.10",
    "cheerio": "1.2.0",
    "ffmpeg-static": "5.3.0",
    "gray-matter": "4.0.3",
    "mdast-util-from-markdown": "^2.0.2",
    "miniflare": "5.20260916.0-alpha",
    "typescript": "^5.9.3",
    "wrangler": "4.133.0",
    "yaml": "2.9.1"
  }
