  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "node scripts/validate-source.mjs && node scripts/prepare-media.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/validate-source.mjs && node scripts/prepare-media.mjs",
    "build": "astro build && node scripts/validate-built.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "precheck": "node scripts/validate-source.mjs && node scripts/prepare-media.mjs",
    "media:import": "node scripts/import-media.mjs",
    "test:auth": "node --test admin-auth/worker.test.mjs",
    "check": "astro check",
    "test:pages": "node scripts/check-page-editing.mjs",
    "test:media": "node scripts/check-portrait-jpeg.mjs",
    "test:preferences": "node scripts/check-dialogue-preference.mjs",
    "test:topics": "node scripts/check-topics.mjs",
    "test:archive": "node scripts/check-archive.mjs",
